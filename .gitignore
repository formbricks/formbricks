# next.js
**/.next/
**/out/
**/build
**/next-env.d.ts

# node
**/dist/

# misc
**/.DS_Store
*.pem
Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!packages/database/.env
!apps/web/.env

# local cloud credentials — the Hub's google-gemini (Vertex) enrichment providers need a GCP
# service-account JSON on disk (HUB_GOOGLE_APPLICATION_CREDENTIALS). It belongs outside the repo,
# but these patterns keep the obvious in-repo spots from being committable if someone drops one here.
**/gcp*.json
**/service-account*.json
**/*-credentials.json
secrets/

# build tools
.turbo
**/*vite.config.*.timestamp-*

# environment specific
.direnv

# Playwright
**/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# project specific
.local/
packages/lib/uploads
apps/web/public/js
packages/database/generated
packages/database/migrations
branch.json
.vercel

# IntelliJ IDEA
/.idea/
/*.iml
packages/ios/FormbricksSDK/FormbricksSDK.xcodeproj/project.xcworkspace/xcuserdata
.cursorrules
i18n.cache
stats.html
# next-agents-md
.next-docs/

# Claude Code config under .claude is team-shared and belongs in the repo:
# settings.json, repo-specific skills, subagents and commands. Company-wide
# skills are distributed from formbricks/skills, not installed into .claude, so
# there is nothing machine-local left to ignore here except personal overrides.
.claude/settings.local.json

# robots design context (machine-local install, not committed)
.agents/formbricks-context
