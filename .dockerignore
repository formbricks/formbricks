# Build context for apps/web/Dockerfile, written as an allowlist: ignore everything, then re-include
# only what the image build reads. An allowlist keeps whatever piles up in a checkout out of the
# context: .git, agent worktrees under .claude/, scratch directories, and local credentials.
#
# These are Docker patterns, not .gitignore patterns. A pattern without `**/` matches only at the
# context root, and the last matching line wins, so a `!` re-include can be narrowed again below it.
# When the build starts reading a new root-level file, re-include it here; docker-build-validation.yml
# fails the PR until you do.
*

# Install inputs (copied ahead of the sources so the install layer survives a source change)
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches

# Build inputs outside apps/ and packages/
!turbo.json
!.nvmrc
!prisma.config.mjs
!authzed/schema.zed

# Workspaces
!apps
!packages
!docker/package.json

# Dependencies and build output
**/node_modules
**/.next
**/.turbo
**/dist
**/build
**/out
**/coverage
**/test-results
**/*.tsbuildinfo
**/next-env.d.ts
**/*vite.config.*.timestamp-*

# Local files
**/*.log
**/.DS_Store
**/*.pem

# Env files and credentials. apps/web/.env is a tracked symlink to the root .env, which stays out.
**/.env
**/.env.*
!apps/web/.env
**/.sentryclirc
**/token.json
**/gcp*.json
**/service-account*.json
**/*-credentials.json

# Runtime state and generated files
apps/web/uploads
apps/web/saml-connection
apps/web/certificates
apps/web/public/js
packages/database/generated
packages/database/.prisma-migrations
packages/database/schema-test-boolean

# Not read by the image build. Storybook's manifest stays: it is a workspace importer in the lockfile.
apps/storybook/**
!apps/storybook/package.json
apps/web/playwright

# Local output of the post-deployment check
apps/deployment-check/report
