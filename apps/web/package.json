{
  "name": "@formbricks/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .turbo node_modules .next coverage",
    "dev": "next dev -p 3000 --turbopack",
    "go": "next dev -p 3000 --turbopack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build && pnpm build:env-validator && pnpm build:authzed-cli",
    "build:authzed-cli": "vite build --config vite.authzed-cli.config.mts",
    "build:env-validator": "vite build --config vite.env-validation.config.mts",
    "build:dev": "pnpm run build",
    "start": "next start",
    "typecheck": "pnpm typegen && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit --project tsconfig.typecheck.json",
    "typegen": "dotenv -e ../../.env -- tsx scripts/typegen.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:coverage": "dotenv -e ../../.env -- vitest run --coverage",
    "test:integration": "node integration/gen-boolean-client.mjs && dotenv -e ../../.env -- vitest run --config vitest.integration.config.mts",
    "i18n:generate": "dotenv -e ../../.env -- npx lingo.dev@latest run && dotenv -e ../../.env -- npx lingo.dev@latest lockfile --force"
  },
