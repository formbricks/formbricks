{
  "name": "@formbricks/workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Formbricks Workflows core library",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && publint",
    "clean": "rimraf .turbo node_modules coverage dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@formbricks/config-eslint": "workspace:*",
    "@formbricks/config-typescript": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "js-yaml": "catalog:",
    "publint": "0.3.21",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
