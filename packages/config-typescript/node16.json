{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ES2021"],
    "module": "commonjs",
    // CommonJS output can't use the "bundler" resolution from base.json, and these
    // packages (database, types) rely on classic Node lookup, so pin it explicitly.
    "moduleResolution": "node10",
    "target": "ES2021"
  },
  "display": "Node 16",
  "extends": "./base.json"
}
