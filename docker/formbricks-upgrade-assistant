cleanup_helm_work_directory() {
  if [[ -n "$helm_work_directory" && -d "$helm_work_directory" ]]; then
    find "$helm_work_directory" -type f -exec chmod 600 {} + 2>/dev/null || true
    rm -rf -- "$helm_work_directory"
  fi
}

verify_checksum_entry() {
  local path="$1"
  local expected_name="$2"
  local actual_digest matches

  [[ -f "$path" && "$(basename -- "$path")" == "$expected_name" ]] || return 1
  actual_digest=$(hash_file "$path")
  matches=$(awk -v digest="$actual_digest" -v name="$expected_name" \
    '$1 == digest && $2 == name { count += 1 } END { print count + 0 }' "$checksums_path")
  [[ "$matches" == "1" ]]
}

verify_helm_release_assets() {
  local checksums_name

  [[ -f "$checksums_path" ]] || return 1
  checksums_name=$(basename -- "$checksums_path")
  [[ "$checksums_name" == "$DEFAULT_CHECKSUMS_NAME" ]] || return 1

  if [[ -z "$formbricks_chart_path" ]]; then
    formbricks_chart_path="${bundle_dir}/${formbricks_chart}"
  fi
  if [[ -z "$upgrade_chart_path" ]]; then
    upgrade_chart_path="${bundle_dir}/${upgrade_chart}"
  fi

  verify_checksum_entry "$manifest_path" "$DEFAULT_MANIFEST_NAME" &&
    verify_checksum_entry "$spicedb_crd_path" "authzed.com_spicedbclusters.yaml" &&
    verify_signed_artifact "$spicedb_crd_path" "$spicedb_crd_digest" &&
    verify_checksum_entry "$formbricks_chart_path" "$formbricks_chart" &&
    verify_checksum_entry "$upgrade_chart_path" "$upgrade_chart"
}

validate_helm_preflight_snapshot() {
  local releases release_data release_count current_status current_revision current_values
  local expected_values normalized_values

  releases=$(helm_capture list --namespace "$helm_namespace" --all -o json) || return 1
  release_data=$(jq -c --arg name "$helm_release" --arg namespace "$helm_namespace" '
    [.[] | select(.name == $name and .namespace == $namespace)]
  ' <<<"$releases") || return 1
  release_count=$(jq -r 'length' <<<"$release_data") || return 1
  [[ "$release_count" == "1" ]] || return 1

  current_status=$(jq -er '.[0].status // empty' <<<"$release_data") || return 1
  current_revision=$(jq -er '.[0].revision // empty | tostring' <<<"$release_data") || return 1
  [[ "$current_status" == "$helm_release_status" && "$current_revision" == "$helm_release_revision" ]] ||
    return 1

  current_values=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" -o json) || return 1
  expected_values=$(jq -Sc '.' <<<"$helm_inspected_values") || return 1
  normalized_values=$(jq -Sc '.' <<<"$current_values") || return 1
  [[ "$normalized_values" == "$expected_values" ]]
}

write_helm_journal() {
  local state="$1"
  local receipt="${2:-}"
  local pending_phase="${3:-}"
  local pending_execution="${4:-0}"
  local temporary

  temporary=$(mktemp "${helm_state_path}.tmp.XXXXXX")
  jq \
    --arg state "$state" \
    --arg receipt "$receipt" \
    --arg pendingPhase "$pending_phase" \
    --argjson pendingExecution "$pending_execution" \
    '.state = $state |
      .receipt = (if $receipt == "" then null else $receipt end) |
      .pendingPhase = (if $pendingPhase == "" then null else $pendingPhase end) |
      .pendingExecution = $pendingExecution |
      .execution = (if $pendingPhase == "" then .execution else $pendingExecution end)' \
    "$helm_state_path" >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$helm_state_path"
}

read_bound_helm_journal() {
  local checksums_digest main_chart_digest upgrade_chart_digest

  [[ -f "$helm_state_path" ]] || return 1
  checksums_digest="sha256:$(hash_file "$checksums_path")"
  main_chart_digest="sha256:$(hash_file "$formbricks_chart_path")"
  upgrade_chart_digest="sha256:$(hash_file "$upgrade_chart_path")"

  jq -cer \
    --arg release "$helm_release" \
    --arg namespace "$helm_namespace" \
    --arg manifestDigest "sha256:${manifest_digest}" \
    --arg checksumsDigest "$checksums_digest" \
    --arg bridgeImage "$bridge_image" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetImage "$target_image" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    --arg mainChart "$formbricks_chart" \
    --arg mainChartDigest "$main_chart_digest" \
    --arg upgradeChart "$upgrade_chart" \
    --arg upgradeChartDigest "$upgrade_chart_digest" \
    'select(
      .schemaVersion == 1 and
      .release.name == $release and .release.namespace == $namespace and
      .signed.manifestDigest == $manifestDigest and
      .signed.checksumsDigest == $checksumsDigest and
      .signed.bridgeImage == $bridgeImage and
      .signed.bridgeManifestDigest == $bridgeManifestDigest and
      .signed.targetImage == $targetImage and
      .signed.targetManifestDigest == $targetManifestDigest and
      .signed.mainChart.name == $mainChart and
      .signed.mainChart.digest == $mainChartDigest and
      .signed.upgradeChart.name == $upgradeChart and
      .signed.upgradeChart.digest == $upgradeChartDigest and
      (.originalValues | type == "object") and
      (.operatorValues | type == "string") and
      (
        (.databaseBinding == {source:"chart_default"}) or
        (
          .databaseBinding.source == "secret_ref" and
          ((.databaseBinding | keys | sort) == ["migrateUrlKey", "secretName", "source", "urlKey"]) and
          (.databaseBinding.secretName | type == "string" and
            test("^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$")) and
          (.databaseBinding.urlKey | type == "string" and length <= 253 and
            test("^[A-Za-z0-9._-]+$")) and
          (.databaseBinding.migrateUrlKey | type == "string" and length <= 253 and
            test("^[A-Za-z0-9._-]+$"))
        )
      ) and
      (.gitopsDetected | type == "boolean") and
      (.workload.deploymentName | type == "string") and
      (.workload.component | type == "string") and
      (.workload.originalImage | type == "string" and length > 0) and
      (.workload.replicas | type == "number") and
      (.workload.hpa.enabled | type == "boolean") and
      (.generation | type == "string") and
      (.upgradeRelease | type == "string") and
      (.state | IN(
        "initialized", "bridge_ready", "prepared", "audited", "quiesced", "activated",
        "candidate_ready", "finalized", "completed", "rollback_started", "rollback_bridge_ready",
        "rolled_back", "manual_recovery_required"
      )) and
      ((.receipt == null) or (.receipt | type == "string")) and
      ((.pendingPhase == null) or (.pendingPhase | type == "string")) and
      (.pendingExecution | type == "number") and
      (.execution | type == "number")
    )' "$helm_state_path" 2>/dev/null
}

