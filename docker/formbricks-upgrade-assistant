ensure_spicedb_crd() {
  local existing_crd rendered_crd attempt=1

  [[ "$helm_desired_authzed_mode" == "selfHosted" ]] || return 0

  existing_crd=$(kubectl_capture get customresourcedefinition spicedbclusters.authzed.com \
    --ignore-not-found -o json) || return 1
  if [[ -n "$existing_crd" ]]; then
    spicedb_crd_is_compatible <<<"$existing_crd"
    return
  fi

  [[ "$spicedb_crd_install_required" == "true" && "$helm_operator_install" == "true" ]] || return 1
  rendered_crd=$(kubectl_capture create --dry-run=client --validate=strict \
    -f "$spicedb_crd_path" -o json) || return 1
  spicedb_crd_contract_is_compatible <<<"$rendered_crd" || return 1

  # Create only. Never apply, patch, replace, or delete a cluster-scoped CRD that another Formbricks
  # release or operator may share. If another installer wins the race, accept only a compatible CRD.
  if ! kubectl_logged create --validate=strict -f "$spicedb_crd_path" -o name; then
    existing_crd=$(kubectl_capture get customresourcedefinition spicedbclusters.authzed.com \
      --ignore-not-found -o json) || return 1
    [[ -n "$existing_crd" ]] && spicedb_crd_is_compatible <<<"$existing_crd"
    return
  fi

  while [[ "$attempt" -le 60 ]]; do
    existing_crd=$(kubectl_capture get customresourcedefinition spicedbclusters.authzed.com \
      --ignore-not-found -o json) || return 1
    if [[ -n "$existing_crd" ]] && spicedb_crd_is_compatible <<<"$existing_crd"; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

detect_flux_helm_release() {
  local resources permission releases

  if ! resources=$(kubectl_capture api-resources --api-group=helm.toolkit.fluxcd.io -o name); then
    printf '%s' "indeterminate"
    return
  fi
  if ! grep -Fxq "helmreleases.helm.toolkit.fluxcd.io" <<<"$resources"; then
    printf '%s' "absent"
    return
  fi

  permission=$(kubectl_capture auth can-i list helmreleases.helm.toolkit.fluxcd.io \
    --namespace "$helm_namespace" || true)
  if [[ "$permission" != "yes" ]]; then
    printf '%s' "indeterminate"
    return
  fi
  if ! releases=$(kubectl_capture get helmreleases.helm.toolkit.fluxcd.io \
    --namespace "$helm_namespace" -o json); then
    printf '%s' "indeterminate"
    return
  fi

  if jq -e --arg release "$helm_release" --arg namespace "$helm_namespace" '
      any(.items[]?;
        ((.spec.releaseName // .metadata.name) == $release) and
        ((.spec.targetNamespace // .metadata.namespace) == $namespace))
    ' <<<"$releases" >/dev/null 2>&1; then
    printf '%s' "detected"
  else
    printf '%s' "absent"
  fi
}

initialize_helm_journal() {
  local deployments deployment_count deployment replicas hpas target_hpas target_hpa_count hpa
  local hpa_enabled=false hpa_min=1 hpa_max=1 gitops_detected=false flux_state
  local revision generation release_hash original_image
  local checksums_digest main_chart_digest upgrade_chart_digest temporary

  helm_deployment_component=$(jq -r '
    (.componentOverride // empty | select(length > 0)) //
    (.nameOverride // empty | select(length > 0)) //
    "formbricks"
  ' <<<"$helm_inspected_values")
  helm_deployment_component="${helm_deployment_component:0:63}"
  helm_deployment_component="${helm_deployment_component%-}"
  helm_selector="app.kubernetes.io/instance=${helm_release},app.kubernetes.io/component=${helm_deployment_component}"

  deployments=$(kubectl_capture get deployments --namespace "$helm_namespace" -l "$helm_selector" -o json) || return 1
  deployment_count=$(jq -r '.items | length' <<<"$deployments")
  [[ "$deployment_count" == "1" ]] || return 1
  deployment=$(jq -c '.items[0]' <<<"$deployments")
  helm_deployment_name=$(jq -er '.metadata.name' <<<"$deployment") || return 1
  if ! validate_helm_database_source_shape ||
    ! resolve_helm_database_binding_from_deployment "$deployment"; then
    return 6
  fi
  original_image=$(jq -er --arg container "$helm_deployment_name" '
    [.spec.template.spec.containers[] | select(.name == $container)] |
    select(length == 1) | .[0].image
  ' <<<"$deployment") || return 1
  replicas=$(jq -er '.spec.replicas // 1' <<<"$deployment") || return 1

  if jq -e '
      ((.metadata.annotations // {}) | keys | any(test("^(argocd\\.argoproj\\.io|fluxcd\\.io|kustomize\\.toolkit\\.fluxcd\\.io)/"))) or
      ((.metadata.labels // {})["app.kubernetes.io/managed-by"] | strings | test("^(ArgoCD|argocd|Flux|flux)$")) or
      ((.metadata.managedFields // []) | any(.manager | strings | test("argocd|flux"; "i")))
    ' <<<"$deployment" >/dev/null 2>&1; then
    gitops_detected=true
  fi
  flux_state=$(detect_flux_helm_release)
  if [[ "$flux_state" == "detected" || "$flux_state" == "indeterminate" ]]; then
    gitops_detected=true
  fi
  if [[ "$gitops_detected" == "true" && "$gitops_paused" != "true" ]]; then
    return 3
  fi

  hpas=$(kubectl_capture get horizontalpodautoscalers --namespace "$helm_namespace" -o json) || return 1
  target_hpas=$(jq -c --arg deployment "$helm_deployment_name" '
    [.items[]? | select(
      .spec.scaleTargetRef.apiVersion == "apps/v1" and
      .spec.scaleTargetRef.kind == "Deployment" and
      .spec.scaleTargetRef.name == $deployment
    )]
  ' <<<"$hpas") || return 1
  target_hpa_count=$(jq -r 'length' <<<"$target_hpas")
  if [[ "$target_hpa_count" -gt 1 ]]; then
    return 5
  fi
  if [[ "$target_hpa_count" == "1" ]]; then
    hpa=$(jq -c '.[0]' <<<"$target_hpas") || return 1
    if ! jq -e --arg name "$helm_deployment_name" --arg release "$helm_release" \
      --arg component "$helm_deployment_component" '
        .metadata.name == $name and
        .metadata.labels["app.kubernetes.io/managed-by"] == "Helm" and
        .metadata.labels["app.kubernetes.io/instance"] == $release and
        .metadata.labels["app.kubernetes.io/component"] == $component
      ' <<<"$hpa" >/dev/null 2>&1; then
      return 5
    fi
    hpa_enabled=true
    hpa_min=$(jq -er '.spec.minReplicas // 1' <<<"$hpa") || return 1
    hpa_max=$(jq -er '.spec.maxReplicas' <<<"$hpa") || return 1
  fi

  revision="$helm_release_revision"
  if [[ -z "$revision" ]]; then
    revision=$(helm_capture status "$helm_release" --namespace "$helm_namespace" -o json |
      jq -er '.version') || return 1
  fi

  generation=$(date +%s)
  release_hash=$(printf '%s' "${helm_namespace}/${helm_release}" | hash_text | cut -c1-8)
  helm_upgrade_release="${helm_release:0:40}-${release_hash}-v6-upgrade"
  checksums_digest="sha256:$(hash_file "$checksums_path")"
  main_chart_digest="sha256:$(hash_file "$formbricks_chart_path")"
  upgrade_chart_digest="sha256:$(hash_file "$upgrade_chart_path")"

  temporary=$(mktemp "${helm_state_path}.tmp.XXXXXX")
  jq -cn \
    --arg release "$helm_release" \
    --arg namespace "$helm_namespace" \
    --arg revision "$revision" \
    --arg manifestDigest "sha256:${manifest_digest}" \
    --arg checksumsDigest "$checksums_digest" \
    --arg bridgeImage "$bridge_image" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetImage "$target_image" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    --arg mainChart "$formbricks_chart" \
    --arg mainChartDigest "$main_chart_digest" \
    --arg upgradeChart "$upgrade_chart" \
    --arg upgradeChartDigest "$upgrade_chart_digest" \
    --argjson originalValues "$helm_inspected_values" \
    --arg operatorValues "$helm_operator_values_content" \
    --arg databaseSource "$helm_database_source" \
    --arg databaseSecret "$helm_database_secret" \
    --arg databaseKey "$helm_database_key" \
    --arg migrateDatabaseKey "$helm_migrate_database_key" \
    --argjson gitopsDetected "$gitops_detected" \
    --arg deploymentName "$helm_deployment_name" \
    --arg component "$helm_deployment_component" \
    --arg originalImage "$original_image" \
    --argjson replicas "$replicas" \
    --argjson hpaEnabled "$hpa_enabled" \
    --argjson hpaMin "$hpa_min" \
    --argjson hpaMax "$hpa_max" \
    --arg generation "$generation" \
    --arg upgradeRelease "$helm_upgrade_release" \
    '{
      schemaVersion: 1,
      state: "initialized",
      receipt: null,
      pendingPhase: null,
      pendingExecution: 0,
      execution: 0,
      release: { name: $release, namespace: $namespace, revision: $revision },
      signed: {
        manifestDigest: $manifestDigest,
        checksumsDigest: $checksumsDigest,
        bridgeImage: $bridgeImage,
        bridgeManifestDigest: $bridgeManifestDigest,
        targetImage: $targetImage,
        targetManifestDigest: $targetManifestDigest,
        mainChart: { name: $mainChart, digest: $mainChartDigest },
        upgradeChart: { name: $upgradeChart, digest: $upgradeChartDigest }
      },
      originalValues: $originalValues,
      operatorValues: $operatorValues,
      databaseBinding: (
        if $databaseSource == "chart_default" then {source: "chart_default"}
        else {
          source: "secret_ref",
          secretName: $databaseSecret,
          urlKey: $databaseKey,
          migrateUrlKey: $migrateDatabaseKey
        } end
      ),
      gitopsDetected: $gitopsDetected,
      workload: {
        deploymentName: $deploymentName,
        component: $component,
        originalImage: $originalImage,
        replicas: $replicas,
        hpa: { enabled: $hpaEnabled, minReplicas: $hpaMin, maxReplicas: $hpaMax }
      },
      generation: $generation,
      upgradeRelease: $upgradeRelease
    }' >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$helm_state_path"
}

load_helm_journal_files() {
  local journal="$1"

  helm_deployment_name=$(jq -er '.workload.deploymentName' <<<"$journal")
  helm_deployment_component=$(jq -er '.workload.component' <<<"$journal")
  helm_selector="app.kubernetes.io/instance=${helm_release},app.kubernetes.io/component=${helm_deployment_component}"
  helm_generation=$(jq -er '.generation' <<<"$journal")
  helm_upgrade_release=$(jq -er '.upgradeRelease' <<<"$journal")

  helm_work_directory=$(mktemp -d "${TMPDIR:-/tmp}/formbricks-v6-helm.XXXXXX")
  chmod 700 "$helm_work_directory"
  helm_original_values_file="${helm_work_directory}/original-values.json"
  helm_operator_values_file="${helm_work_directory}/operator-values.yaml"
  helm_retired_values_file="${helm_work_directory}/retired-values.json"
  helm_phase_values_file="${helm_work_directory}/phase-values.json"
  jq '.originalValues' <<<"$journal" >"$helm_original_values_file"
  jq -r '.operatorValues' <<<"$journal" >"$helm_operator_values_file"
  jq -cn '{
    migration: { enabled: null },
    authzed: { migrationAcknowledged: null, initialization: null }
  }' >"$helm_retired_values_file"
  chmod 600 "$helm_original_values_file" "$helm_operator_values_file" "$helm_retired_values_file"
}

write_main_phase_values() {
  local image="$1"
  local migration_mode="$2"
  local replicas="$3"
  local hpa_enabled="$4"
  local gate_enabled="$5"
  local repository digest hpa_min hpa_max

  repository="${image%@*}"
  digest="${image##*@}"
  hpa_min=$(jq -er '.workload.hpa.minReplicas' "$helm_state_path")
  hpa_max=$(jq -er '.workload.hpa.maxReplicas' "$helm_state_path")
  jq -cn \
    --arg repository "$repository" \
    --arg digest "$digest" \
    --arg databaseSecret "$helm_database_secret" \
    --arg databaseKey "$helm_database_key" \
    --arg migrateDatabaseKey "$helm_migrate_database_key" \
    --arg migrationMode "$migration_mode" \
    --argjson replicas "$replicas" \
    --argjson hpaEnabled "$hpa_enabled" \
    --argjson hpaMin "$hpa_min" \
    --argjson hpaMax "$hpa_max" \
    --argjson gateEnabled "$gate_enabled" \
    '{
      deployment: {
        image: { repository: $repository, digest: $digest, tag: null },
        replicas: $replicas,
        env: (if $databaseSecret == "" then {} else {
          DATABASE_URL: {
            valueFrom: { secretKeyRef: { name: $databaseSecret, key: $databaseKey, optional: false } }
          }
        } end)
      },
      autoscaling: { enabled: $hpaEnabled, minReplicas: $hpaMin, maxReplicas: $hpaMax },
      migration: (
        (if $migrationMode == "" then {} else { mode: $migrationMode } end) +
        (if $databaseSecret == "" then {} else {
          database: {
            existingSecret: $databaseSecret,
            urlKey: $databaseKey,
            migrateUrlKey: $migrateDatabaseKey
          }
        } end)
      ),
      authzed: {
        enabled: true,
        consistency: "fully_consistent",
        activation: {
          installBootstrap: { enabled: false, retryOnUpgrade: false },
          upgradeGate: { enabled: $gateEnabled },
          database: (if $databaseSecret == "" then {} else {
            existingSecret: $databaseSecret,
            urlKey: $databaseKey
          } end)
        }
      }
    }' >"$helm_phase_values_file"
  chmod 600 "$helm_phase_values_file"
}

run_main_chart_upgrade() {
  local phase="$1"

  # Render against the live cluster so chart lookups can retain generated credentials from the
  # existing release. A client-only `helm template` cannot see those Secrets and rejects the default
  # bundled-PostgreSQL upgrade as if its passwords were missing. Suppress rendered output and hide
  # Secret manifests so the validation log cannot capture credentials.
  if ! helm_render_logged upgrade "$helm_release" "$formbricks_chart_path" \
    --namespace "$helm_namespace" \
    --reset-values \
    --values "$helm_original_values_file" \
    --values "$helm_operator_values_file" \
    --values "$helm_retired_values_file" \
    --values "$helm_phase_values_file" \
    --dry-run=server --hide-secret; then
    return 1
  fi

  printf '%s\n' "🔐 Applying the signed Helm ${phase} revision." >&2
  helm_logged upgrade "$helm_release" "$formbricks_chart_path" \
    --namespace "$helm_namespace" \
    --reset-values \
    --values "$helm_original_values_file" \
    --values "$helm_operator_values_file" \
    --values "$helm_retired_values_file" \
    --values "$helm_phase_values_file" \
    --wait --wait-for-jobs --timeout 45m
}

wait_for_zero_formbricks_pods() {
  local attempt=1 pods
  while [[ "$attempt" -le 120 ]]; do
    pods=$(kubectl_capture get pods --namespace "$helm_namespace" -l "$helm_selector" -o json) || return 1
    if jq -e '[.items[] | select(.metadata.deletionTimestamp == null)] | length == 0' \
      <<<"$pods" >/dev/null 2>&1; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

verify_helm_workload_image() {
  local expected_image="$1"
  local expected_digest="${expected_image##*@}"
  local deployment pods

  kubectl_logged rollout status "deployment/${helm_deployment_name}" --namespace "$helm_namespace" \
    --timeout=15m || return 1
  deployment=$(kubectl_capture get deployment "$helm_deployment_name" --namespace "$helm_namespace" -o json) ||
    return 1
  jq -e --arg image "$expected_image" \
    --arg container "$helm_deployment_name" \
    '[.spec.template.spec.containers[] | select(.name == $container and .image == $image)] | length == 1' \
    <<<"$deployment" >/dev/null 2>&1 || return 1
  pods=$(kubectl_capture get pods --namespace "$helm_namespace" -l "$helm_selector" -o json) || return 1
  HELM_EXPECTED_DIGEST="$expected_digest" HELM_APP_CONTAINER="$helm_deployment_name" jq -e '
    [.items[] | select(.metadata.deletionTimestamp == null)] as $pods |
    ($pods | length) > 0 and
    all($pods[];
      any(.status.containerStatuses[]?;
        .name == $ENV.HELM_APP_CONTAINER and .ready == true and
        (.imageID | endswith("@" + $ENV.HELM_EXPECTED_DIGEST))))
  ' <<<"$pods" >/dev/null 2>&1
}

run_helm_runtime_check() {
  local expected_authority="$1"
  local output
  output=$(kubectl_capture exec --namespace "$helm_namespace" "deployment/${helm_deployment_name}" -- \
    formbricks-authzed activation runtime-check) || return 1
  jq -e --arg authority "$expected_authority" \
    '.status == "ready" and .authority == $authority' <<<"$output" >/dev/null 2>&1
}

wait_for_helm_application_health() {
  local attempt=1

  while [[ "$attempt" -le 30 ]]; do
    if kubectl_logged exec --namespace "$helm_namespace" "deployment/${helm_deployment_name}" -- \
      node -e '
        const port = process.env.PORT || "3000";
        fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(5000) })
          .then((response) => process.exit(response.ok ? 0 : 1))
          .catch(() => process.exit(1));
      '; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

write_temporary_chart_values() {
  local phase="$1"
  local execution="$2"
  local receipt="$3"
  local quiesced="$4"
  local effective endpoint mode app_name auth_secret token_key database_secret database_key
  local system_key insecure node_selector tolerations affinity pull_secrets service_account
  local disable_istio_inject pod_labels pod_annotations

  effective=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" --all -o json) || return 1
  mode=$(jq -er '.authzed.mode' <<<"$effective") || return 1
  app_name=$(jq -r '(.nameOverride // empty | select(length > 0)) // "formbricks"' <<<"$effective")
  app_name="${app_name:0:63}"
  app_name="${app_name%-}"
  endpoint=$(jq -r '.authzed.endpoint // empty' <<<"$effective")
  if [[ -z "$endpoint" && "$mode" == "selfHosted" ]]; then
    endpoint=$(jq -r --arg fallback "${app_name}-spicedb" '.authzed.cluster.name // empty | select(length > 0) // $fallback' \
      <<<"$effective")
    endpoint="${endpoint:0:63}"
    endpoint="${endpoint%-}:50051"
  fi
  [[ -n "$endpoint" ]] || return 1
  auth_secret=$(jq -r --arg fallback "${app_name}-authzed" \
    '.authzed.auth.existingSecret // empty | select(length > 0) // $fallback' <<<"$effective")
  token_key=$(jq -er '.authzed.auth.tokenKey' <<<"$effective") || return 1
  database_secret=$(jq -r --arg fallback "${app_name}-app-secrets" \
    '.authzed.activation.database.existingSecret // empty | select(length > 0) // $fallback' <<<"$effective")
  database_key=$(jq -er '.authzed.activation.database.urlKey' <<<"$effective") || return 1
  system_key=$(jq -er '.authzed.systemKey' <<<"$effective") || return 1
  insecure=$(jq -r 'if (.authzed.insecure | type) == "boolean" then .authzed.insecure else (.authzed.mode == "selfHosted") end' \
    <<<"$effective")
  node_selector=$(jq -c '.deployment.nodeSelector // {}' <<<"$effective")
  tolerations=$(jq -c '.deployment.tolerations // []' <<<"$effective")
  affinity=$(jq -c '.deployment.affinity // {}' <<<"$effective")
  pull_secrets=$(jq -c 'if (.deployment.imagePullSecrets | type) == "array" then .deployment.imagePullSecrets else [] end' \
    <<<"$effective")
  service_account=$(jq -r --arg fallback "$helm_deployment_name" '
    if .rbac.serviceAccount.enabled == true then
      (.rbac.serviceAccount.name // "" | if length > 0 then . else $fallback end)
    else "" end
  ' <<<"$effective")
  pod_labels=$(jq -c '
    (.deployment.additionalPodLabels // {}) |
    if type != "object" then {} else
      with_entries(select((.key | startswith("formbricks.com/") or startswith("app.kubernetes.io/")) | not))
    end
  ' <<<"$effective")
  disable_istio_inject=$(jq -r '.deployment.disableIstioInject == true' <<<"$effective")
  if [[ "$disable_istio_inject" == "true" ]]; then
    # This is the one application pod label whose behavior must carry into the temporary Jobs. If an
    # operator disabled Istio injection, injecting only the cutover Jobs can hang them after the CLI
    # exits or give them different strict-mTLS reachability from the Formbricks application.
    pod_labels=$(jq -c '. + {"sidecar.istio.io/inject":"false"}' <<<"$pod_labels")
  fi
  # Application annotations are not safe to copy to short-lived privileged cutover jobs. Service-mesh,
  # secret-agent, and observability injectors can add sidecars that keep jobs alive or gain access to the
  # database/AuthZed credentials. The temporary chart remains intentionally annotation-free.
  pod_annotations='{}'
  jq -cn \
    --arg targetRelease "$helm_release" \
    --arg generation "$helm_generation" \
    --arg phase "$phase" \
    --argjson execution "$execution" \
    --arg bridgeRepository "${bridge_image%@*}" \
    --arg bridgeDigest "$bridge_digest" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetRepository "${target_image%@*}" \
    --arg targetDigest "$target_digest" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    --arg receipt "$receipt" \
    --argjson quiesced "$quiesced" \
    --arg endpoint "$endpoint" \
    --arg authSecret "$auth_secret" \
    --arg tokenKey "$token_key" \
    --arg databaseSecret "$database_secret" \
    --arg databaseKey "$database_key" \
    --arg systemKey "$system_key" \
    --argjson insecure "$insecure" \
    --argjson nodeSelector "$node_selector" \
    --argjson tolerations "$tolerations" \
    --argjson affinity "$affinity" \
    --argjson pullSecrets "$pull_secrets" \
    --arg serviceAccount "$service_account" \
    --argjson podLabels "$pod_labels" \
    --argjson podAnnotations "$pod_annotations" \
    '{
      targetRelease: $targetRelease,
      generation: $generation,
      phase: $phase,
      execution: $execution,
      protocolVersion: 1,
      images: {
        bridge: { repository: $bridgeRepository, digest: $bridgeDigest, manifestDigest: $bridgeManifestDigest },
        candidate: { repository: $targetRepository, digest: $targetDigest, manifestDigest: $targetManifestDigest },
        pullPolicy: "IfNotPresent",
        pullSecrets: $pullSecrets
      },
      schema: { expectedCurrentDigest: "" },
      activation: { receipt: $receipt, workloadQuiesced: $quiesced },
      database: { existingSecret: { name: $databaseSecret, key: $databaseKey } },
      authzed: {
        endpoint: $endpoint,
        existingSecret: { name: $authSecret, key: $tokenKey },
        systemKey: $systemKey,
        insecure: $insecure,
        consistency: "fully_consistent"
      },
      cli: { executable: "formbricks-authzed" },
      job: {
        ttlSecondsAfterFinished: 600,
        activeDeadlineSeconds: {
          status: 300, prepare: 21600, audit: 21600, activate: 2100,
          rollbackBegin: 900, rollbackComplete: 900
        },
        activateConflictRetrySeconds: 960,
        activateConflictRetryIntervalSeconds: 5,
        serviceAccountName: $serviceAccount,
        podLabels: $podLabels,
        podAnnotations: $podAnnotations,
        podSecurityContext: {
          runAsNonRoot: true,
          seccompProfile: { type: "RuntimeDefault" }
        },
        containerSecurityContext: {
          allowPrivilegeEscalation: false,
          capabilities: { drop: ["ALL"] },
          readOnlyRootFilesystem: true,
          runAsNonRoot: true
        },
        resources: {
          requests: { cpu: "100m", memory: "256Mi" },
          limits: { cpu: "500m", memory: "1Gi" }
        }
      },
      nodeSelector: $nodeSelector,
      tolerations: $tolerations,
      affinity: $affinity
    }' >"$helm_phase_values_file"
  chmod 600 "$helm_phase_values_file"
}

temporary_phase_job_output() {
  local phase="$1"
  local execution="$2"
  local jobs count job_name succeeded failed

  jobs=$(kubectl_capture get jobs --namespace "$helm_namespace" \
    -l "formbricks.com/upgrade-generation=${helm_generation},formbricks.com/upgrade-phase=${phase},formbricks.com/upgrade-execution=${execution}" \
    -o json) || return 1
  count=$(jq -r '.items | length' <<<"$jobs")
  [[ "$count" == "1" ]] || return 1
  job_name=$(jq -er '.items[0].metadata.name' <<<"$jobs") || return 1
  succeeded=$(jq -r '.items[0].status.succeeded // 0' <<<"$jobs")
  failed=$(jq -r '.items[0].status.failed // 0' <<<"$jobs")
  if [[ "$succeeded" != "1" && "$failed" == "0" ]]; then
    kubectl_logged wait --for=condition=complete --timeout=45m "job/${job_name}" \
      --namespace "$helm_namespace" || return 1
    jobs=$(kubectl_capture get job "$job_name" --namespace "$helm_namespace" -o json) || return 1
    succeeded=$(jq -r '.status.succeeded // 0' <<<"$jobs")
  fi
  [[ "$succeeded" == "1" ]] || return 1
  kubectl_capture logs --namespace "$helm_namespace" "job/${job_name}"
}

recover_temporary_helm_release() {
  local releases release_status history recovery_revision

  releases=$(helm_capture list --namespace "$helm_namespace" --all -o json) || return 1
  release_status=$(jq -er --arg release "$helm_upgrade_release" '
    [.[] | select(.name == $release)] |
    if length == 0 then "absent"
    elif length == 1 then (.[0].status // "unknown")
    else error("ambiguous temporary release")
    end
  ' <<<"$releases") || return 1

  case "$release_status" in
    absent|deployed|failed) return 0 ;;
    pending-install)
      # The chart contains only disposable coordination objects. If the initial Helm client vanished
      # before storing a release revision, remove that incomplete shell and recreate the same signed,
      # journal-bound phase. Database authority is consulted separately before any image choice.
      helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait || return 1
      ;;
    pending-upgrade|pending-rollback)
      history=$(helm_capture history "$helm_upgrade_release" --namespace "$helm_namespace" -o json) || return 1
      recovery_revision=$(jq -er '
        [.[] | select((.status == "deployed" or .status == "superseded") and (.revision | tonumber > 0))] |
        sort_by(.revision | tonumber) | last | .revision
      ' <<<"$history") || return 1
      # This rollback is deliberately restricted to the temporary, resource-only coordinator chart.
      # The application release is recovered separately according to database authority.
      helm_logged rollback "$helm_upgrade_release" "$recovery_revision" --namespace "$helm_namespace" \
        --no-hooks --wait --timeout 15m || return 1
      ;;
    *) return 1 ;;
  esac
}

run_temporary_phase() {
  local phase="$1"
  local receipt="${2:-}"
  local quiesced="${3:-false}"
  local pending_phase pending_execution execution output

  if [[ -z "$receipt" ]]; then
    receipt=$(jq -r '.receipt // empty' "$helm_state_path")
  fi

  pending_phase=$(jq -r '.pendingPhase // empty' "$helm_state_path")
  pending_execution=$(jq -r '.pendingExecution // 0' "$helm_state_path")
  if [[ "$pending_phase" == "$phase" && "$pending_execution" -gt 0 ]]; then
    execution="$pending_execution"
    output=$(temporary_phase_job_output "$phase" "$execution" 2>/dev/null || true)
    if [[ -n "$output" ]]; then
      printf '%s' "$output"
      return 0
    fi
    execution=$(jq -r '.execution + 1' "$helm_state_path")
    write_helm_journal "$(jq -r '.state' "$helm_state_path")" "$receipt" "$phase" "$execution"
  else
    execution=$(jq -r '.execution + 1' "$helm_state_path")
    write_helm_journal "$(jq -r '.state' "$helm_state_path")" "$receipt" "$phase" "$execution"
  fi

  recover_temporary_helm_release || return 1
  write_temporary_chart_values "$phase" "$execution" "$receipt" "$quiesced" || return 1
  printf '%s\n' "🔐 Running the signed Helm ${phase} coordinator phase." >&2
  helm_render_logged upgrade --install "$helm_upgrade_release" "$upgrade_chart_path" \
    --namespace "$helm_namespace" --reset-values --values "$helm_phase_values_file" \
    --dry-run=server --hide-secret || return 1
  helm_logged upgrade --install "$helm_upgrade_release" "$upgrade_chart_path" \
    --namespace "$helm_namespace" --reset-values --values "$helm_phase_values_file" \
    --wait --wait-for-jobs --timeout 45m || return 1
  output=$(temporary_phase_job_output "$phase" "$execution") || return 1
  printf '%s' "$output"
}

get_activation_status_via_chart() {
  local output
  output=$(run_temporary_phase status "" false) || return 1
  jq -cer 'select(.status == "ready" and (.authority | IN("legacy", "spicedb"))) |
    {authority, transition}' <<<"$output"
}

current_main_helm_release_status() {
  local releases
  releases=$(helm_capture list --namespace "$helm_namespace" --all -o json) || return 1
  jq -er --arg release "$helm_release" '
    [.[] | select(.name == $release)] |
    select(length == 1) | .[0].status
  ' <<<"$releases"
}

validate_original_helm_revision() {
  local revision="$1"
  local revision_values expected_values
  revision_values=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" \
    --revision "$revision" -o json) || return 1
  expected_values=$(jq -Sc '.originalValues' "$helm_state_path") || return 1
  revision_values=$(jq -Sc '.' <<<"$revision_values") || return 1
  [[ "$revision_values" == "$expected_values" ]]
}

find_quiesced_bridge_revision() {
  local history revisions revision revision_values repository digest
  repository="${bridge_image%@*}"
  digest="${bridge_image##*@}"
  history=$(helm_capture history "$helm_release" --namespace "$helm_namespace" -o json) || return 1
  revisions=$(jq -r '
    [.[] | select(.status == "deployed" or .status == "superseded")] |
    sort_by(.revision | tonumber) | reverse | .[].revision
  ' <<<"$history") || return 1
  while IFS= read -r revision; do
    [[ -n "$revision" ]] || continue
    revision_values=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" \
      --revision "$revision" -o json) || continue
    if jq -e --arg repository "$repository" --arg digest "$digest" '
      .deployment.image.repository == $repository and
      .deployment.image.digest == $digest and
      .deployment.replicas == 0 and
      .autoscaling.enabled == false and
      .migration.mode == "external" and
      .authzed.activation.installBootstrap.enabled == false and
      .authzed.activation.upgradeGate.enabled == false
    ' <<<"$revision_values" >/dev/null 2>&1; then
      printf '%s' "$revision"
      return 0
    fi
  done <<<"$revisions"
  return 1
}

recover_pending_main_helm_release() {
  local authority="$1"
  local release_status recovery_revision original_revision

  release_status=$(current_main_helm_release_status) || return 1
  case "$release_status" in
    deployed|failed) return 0 ;;
    pending-upgrade|pending-rollback) ;;
    *) return 1 ;;
  esac

  if [[ "$authority" == "legacy" ]]; then
    original_revision=$(jq -er '.release.revision' "$helm_state_path") || return 1
    validate_original_helm_revision "$original_revision" || return 1
    recovery_revision="$original_revision"
  elif [[ "$authority" == "spicedb" ]]; then
    # Never restore a live legacy revision after authority has changed. The only safe Helm unlock
    # target is a previously rendered exact bridge revision with zero replicas and no HPA.
    recovery_revision=$(find_quiesced_bridge_revision) || return 1
  else
    return 1
  fi

  printf '%s\n' "↩️ Recovering an interrupted Helm client at a journal-verified safe revision." >&2
  helm_logged rollback "$helm_release" "$recovery_revision" --namespace "$helm_namespace" \
    --no-hooks --wait --timeout 30m || return 1
  if [[ "$authority" == "spicedb" ]]; then
    wait_for_zero_formbricks_pods || return 1
  fi
}

verify_original_helm_workload() {
  local expected_image replicas hpa_enabled deployment

  expected_image=$(jq -er '.workload.originalImage' "$helm_state_path") || return 1
  replicas=$(jq -er '.workload.replicas' "$helm_state_path") || return 1
  hpa_enabled=$(jq -er '.workload.hpa.enabled' "$helm_state_path") || return 1
  kubectl_logged rollout status "deployment/${helm_deployment_name}" --namespace "$helm_namespace" \
    --timeout=15m || return 1
  deployment=$(kubectl_capture get deployment "$helm_deployment_name" --namespace "$helm_namespace" -o json) ||
    return 1
  jq -e --arg image "$expected_image" --arg container "$helm_deployment_name" '
    [.spec.template.spec.containers[] | select(.name == $container and .image == $image)] | length == 1
  ' <<<"$deployment" >/dev/null 2>&1 || return 1

  # A deliberately dormant release has no application process to probe. Its exact Deployment image
  # and zero-Pod state are the complete safe-source assertion; active releases must answer /health.
  if [[ "$replicas" == "0" && "$hpa_enabled" == "false" ]]; then
    wait_for_zero_formbricks_pods
  else
    wait_for_helm_application_health
  fi
}

restore_original_helm_release() {
  local original_revision release_status

  original_revision=$(jq -er '.release.revision' "$helm_state_path") || return 1
  validate_original_helm_revision "$original_revision" || return 1
  release_status=$(current_main_helm_release_status) || return 1
  case "$release_status" in
    pending-upgrade|pending-rollback)
      recover_pending_main_helm_release legacy || return 1
      verify_original_helm_workload
      return $?
      ;;
    deployed)
      if verify_original_helm_workload; then
        return 0
      fi
      ;;
    failed) ;;
    *) return 1 ;;
  esac

  printf '%s\n' "↩️ Restoring the journal-verified pre-upgrade Helm revision." >&2
  helm_logged rollback "$helm_release" "$original_revision" --namespace "$helm_namespace" \
    --no-hooks --wait --timeout 30m || return 1
  verify_original_helm_workload
}

restore_helm_bridge() {
  local intended="$1"
  local replicas hpa_enabled

  # A vanished Helm client can leave the application release locked. Database authority is legacy
  # at every call site here, so only the journal-verified original revision may unlock it.
  recover_pending_main_helm_release legacy || return 1

  if [[ "$intended" == "true" ]]; then
    replicas=$(jq -r '.workload.replicas' "$helm_state_path")
    hpa_enabled=$(jq -r '.workload.hpa.enabled' "$helm_state_path")
  else
    replicas=1
    hpa_enabled=false
  fi
  write_main_phase_values "$bridge_image" external "$replicas" "$hpa_enabled" false
  run_main_chart_upgrade "bridge recovery" || return 1
  verify_helm_workload_image "$bridge_image" || return 1
  run_helm_runtime_check legacy || return 1
  # A deliberately dormant source release has no process to probe. Active bridge workloads must
  # serve /health before recovery is considered complete.
  if [[ "$replicas" == "0" && "$hpa_enabled" == "false" ]]; then
    return 0
  fi
  wait_for_helm_application_health
}

quiesce_helm_candidate_for_rollback() {
  local release_status
  release_status=$(current_main_helm_release_status) || return 1
  if [[ "$release_status" == "pending-upgrade" || "$release_status" == "pending-rollback" ]]; then
    recover_pending_main_helm_release spicedb || return 1
    wait_for_zero_formbricks_pods
    return $?
  fi
  [[ "$release_status" == "deployed" || "$release_status" == "failed" ]] || return 1

  write_main_phase_values "$target_image" external 0 false true
  run_main_chart_upgrade "quiesced rollback candidate" && wait_for_zero_formbricks_pods
}

rollback_helm_after_activation() {
  local receipt="$1"
  local rollback_output status_output authority

  printf '%s\n' "↩️ Candidate verification failed; restoring the signed Helm bridge." >&2
  status_output=$(get_activation_status_via_chart 2>/dev/null || true)
  authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
  if [[ "$authority" == "legacy" ]]; then
    # A previous rollback-complete transaction may have committed before its client received the
    # response. Repeating the exact receipt is the only accepted legacy/idle completion path.
    rollback_output=$(run_temporary_phase rollback-complete "$receipt" false) || return 1
    jq -e '.status == "rolled_back"' <<<"$rollback_output" >/dev/null 2>&1 || return 1
    restore_helm_bridge true || return 1
    write_helm_journal rolled_back "$receipt"
    helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait || return 1
    return 0
  fi
  [[ "$authority" == "spicedb" ]] || return 1

  quiesce_helm_candidate_for_rollback || return 1
  rollback_output=$(run_temporary_phase rollback-begin "$receipt" true) || return 1
  jq -e '.status == "rollback_started"' <<<"$rollback_output" >/dev/null 2>&1 || return 1
  write_helm_journal rollback_started "$receipt"

  write_main_phase_values "$bridge_image" external 1 false false
  run_main_chart_upgrade "rollback bridge" || return 1
  verify_helm_workload_image "$bridge_image" || return 1
  run_helm_runtime_check legacy || return 1
  # Do not release the database authority fence until the rollback bridge serves the application.
  wait_for_helm_application_health || return 1
  write_helm_journal rollback_bridge_ready "$receipt"

  rollback_output=$(run_temporary_phase rollback-complete "$receipt" false) || return 1
  jq -e '.status == "rolled_back"' <<<"$rollback_output" >/dev/null 2>&1 || return 1
  restore_helm_bridge true || return 1
  write_helm_journal rolled_back "$receipt"
  helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait || return 1
}

emit_helm_upgrade_success() {
  jq -cn --arg releaseVersion "$release_version" \
    '{schemaVersion: 1, status: "upgraded", mutating: true, installType: "helm", releaseVersion: $releaseVersion}'
}

execute_helm_upgrade() {
  local journal state receipt status_output authority transition prepare_output audit_output activate_output
  local replicas hpa_enabled finalize_output
  local resume_activation=false

  if [[ "$resolved_install_type" != "helm" ]]; then
    emit_bootstrap_error "helm_upgrade_required"
    return 2
  fi
  if [[ "$confirmed" != "true" || "$backup_confirmed" != "true" ]]; then
    emit_bootstrap_error "helm_confirmation_required"
    return 2
  fi
  if ! verify_helm_release_assets; then
    emit_bootstrap_error "signed_helm_artifact_invalid"
    return 2
  fi

  if [[ -z "$helm_state_path" ]]; then
    helm_state_path="${PWD}/.formbricks-v6-helm-upgrade-${helm_namespace}-${helm_release}.json"
  fi
  helm_upgrade_log="${helm_state_path%.json}.log"
  umask 077
  touch "$helm_upgrade_log"
  chmod 600 "$helm_upgrade_log"

  # Preflight runs before the release-scoped assistant Lease is acquired. An ordinary Helm upgrade
  # does not participate in that Lease, so bind execution to the exact release revision and values
  # that passed preflight before creating recovery state or changing any cluster resource.
  if ! validate_helm_preflight_snapshot; then
    emit_bootstrap_error "helm_release_changed_since_preflight"
    return 2
  fi

  if [[ "$action" == "resume" ]]; then
    journal=$(read_bound_helm_journal || true)
    if [[ -z "$journal" ]]; then
      emit_bootstrap_error "helm_upgrade_state_invalid"
      return 2
    fi
    if jq -e '.gitopsDetected == true' <<<"$journal" >/dev/null 2>&1 &&
      [[ "$gitops_paused" != "true" ]]; then
      emit_bootstrap_error "gitops_reconciliation_not_paused"
      return 2
    fi
  else
    if [[ -e "$helm_state_path" ]]; then
      emit_bootstrap_error "helm_upgrade_state_exists"
      return 2
    fi
    set +e
    initialize_helm_journal
    initialize_result=$?
    set -e
    if [[ "$initialize_result" -ne 0 ]]; then
      case "$initialize_result" in
        3) emit_bootstrap_error "gitops_reconciliation_not_paused" ;;
        4) emit_bootstrap_error "helm_values_unsafe" ;;
        5) emit_bootstrap_error "unsupported_external_hpa" ;;
        6) emit_bootstrap_error "helm_database_source_changed" ;;
        *) emit_bootstrap_error "helm_workload_snapshot_failed" ;;
      esac
      return 2
    fi
    journal=$(read_bound_helm_journal || true)
    if [[ -z "$journal" ]]; then
      emit_bootstrap_error "helm_upgrade_state_invalid"
      return 2
    fi
  fi

  # A resume must use the mode and operator decision that were captured before the first mutation,
  # not values from an interrupted live release or a newly supplied override file.
  helm_inspected_values=$(jq -cer '.originalValues' <<<"$journal") || {
    emit_bootstrap_error "helm_upgrade_state_invalid"
    return 2
  }
  helm_operator_values_content=$(jq -er '.operatorValues' <<<"$journal" |
    normalize_safe_helm_operator_values) || {
    emit_bootstrap_error "helm_upgrade_state_invalid"
    return 2
  }
  if ! load_helm_database_binding_from_journal "$journal"; then
    emit_bootstrap_error "helm_upgrade_state_invalid"
    return 2
  fi
  if ! resolve_helm_authzed_mode; then
    emit_bootstrap_error "helm_upgrade_state_invalid"
    return 2
  fi

  # Helm intentionally does not install dependency CRDs on upgrade. Install only the release-signed
  # SpiceDBCluster CRD when the self-hosted path needs it, and never replace a compatible shared CRD.
  # All journal, GitOps, and confirmation gates have succeeded before this first cluster mutation.
  if ! ensure_spicedb_crd; then
    emit_bootstrap_error "spicedb_crd_install_failed"
    return 2
  fi

  load_helm_journal_files "$journal"
  trap 'cleanup_helm_work_directory; release_upgrade_lock' EXIT
  state=$(jq -r '.state' "$helm_state_path")
  receipt=$(jq -r '.receipt // empty' "$helm_state_path")

  if [[ "$state" == "completed" ]]; then
    write_main_phase_values "$target_image" "" \
      "$(jq -r '.workload.replicas' "$helm_state_path")" \
      "$(jq -r '.workload.hpa.enabled' "$helm_state_path")" true
    if verify_helm_workload_image "$target_image" && run_helm_runtime_check spicedb &&
      wait_for_helm_application_health; then
      emit_helm_upgrade_success
      return 0
    fi
    emit_bootstrap_error "helm_completed_state_invalid"
    return 1
  fi

  if [[ "$action" == "resume" && "$state" != "completed" ]]; then
    # An initialized journal cannot have crossed the authority boundary: no receipt has been prepared.
    # This lets recovery unlock a Helm client that disappeared during the first bridge upgrade, even
    # when SpiceDB resources were not created far enough for the status Job to start.
    authority=legacy
    transition=idle
    if [[ "$state" != "initialized" ]]; then
      # The process may have disappeared after a database transaction committed but before the journal
      # write. Consult the durable authority state before choosing an image; never infer authority from
      # the running image or the journal alone.
      status_output=$(get_activation_status_via_chart 2>/dev/null || true)
      authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
      transition=$(jq -r '.transition // empty' <<<"$status_output" 2>/dev/null || true)
      if [[ "$authority" == "spicedb" ]]; then
        if [[ -z "$receipt" ]]; then
          write_helm_journal manual_recovery_required
          emit_bootstrap_error "helm_activation_state_requires_recovery"
          return 1
        fi
        if [[ "$transition" == "rollback_fencing" || "$transition" == "rolling_back" ]]; then
          write_helm_journal rollback_started "$receipt"
          state=rollback_started
        else
          write_helm_journal activated "$receipt"
          state=activated
        fi
      elif [[ "$authority" != "legacy" ]]; then
        write_helm_journal manual_recovery_required "$receipt"
        emit_bootstrap_error "helm_activation_status_failed"
        return 1
      elif [[ "$transition" == "activating" && "$state" == "quiesced" && -n "$receipt" ]]; then
        resume_activation=true
      fi
    fi

    if ! recover_pending_main_helm_release "$authority"; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_release_recovery_failed"
      return 1
    fi
  fi

  if [[ "$state" == "rollback_started" || "$state" == "rollback_bridge_ready" ||
    "$state" == "manual_recovery_required" ]]; then
    if [[ -n "$receipt" ]] && rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "interrupted_helm_upgrade_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_rollback_incomplete"
    fi
    return 1
  fi

  if [[ "$state" == "activated" || "$state" == "candidate_ready" || "$state" == "finalized" ]]; then
    authority=spicedb
    transition=activating
  else
    authority=legacy
    transition=idle
  fi

  if [[ "$resume_activation" == "true" ]]; then
    if ! wait_for_zero_formbricks_pods; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_interrupted_activation_not_quiesced"
      return 1
    fi
    activate_output=$(run_temporary_phase activate "$receipt" true) || {
      status_output=$(get_activation_status_via_chart 2>/dev/null || true)
      authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
      if [[ "$authority" == "spicedb" ]]; then
        write_helm_journal activated "$receipt"
        rollback_helm_after_activation "$receipt" || write_helm_journal manual_recovery_required "$receipt"
      else
        restore_helm_bridge true || true
      fi
      emit_bootstrap_error "helm_activation_failed"
      return 1
    }
    if ! jq -e '.status == "activated"' <<<"$activate_output" >/dev/null 2>&1; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_activation_failed"
      return 1
    fi
    write_helm_journal activated "$receipt"
    state=activated
  fi

  if [[ "$state" != "activated" && "$state" != "candidate_ready" && "$state" != "finalized" ]]; then
    write_main_phase_values "$bridge_image" job \
      "$(jq -r '.workload.replicas' "$helm_state_path")" \
      "$(jq -r '.workload.hpa.enabled' "$helm_state_path")" false
    if ! run_main_chart_upgrade "legacy-authoritative bridge" ||
      ! verify_helm_workload_image "$bridge_image" || ! run_helm_runtime_check legacy ||
      ! wait_for_helm_application_health; then
      if restore_original_helm_release; then
        emit_bootstrap_error "helm_bridge_deployment_failed"
      else
        write_helm_journal manual_recovery_required "$receipt"
        emit_bootstrap_error "helm_bridge_deployment_recovery_incomplete"
      fi
      return 1
    fi
    write_helm_journal bridge_ready "$receipt"

    status_output=$(get_activation_status_via_chart) || {
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_activation_status_failed"
      return 1
    }
    authority=$(jq -r '.authority' <<<"$status_output")
    transition=$(jq -r '.transition' <<<"$status_output")
    if [[ "$authority" == "spicedb" ]]; then
      if [[ -z "$receipt" ]]; then
        write_helm_journal manual_recovery_required
        emit_bootstrap_error "helm_activation_state_requires_recovery"
        return 1
      fi
      write_helm_journal activated "$receipt"
    elif [[ "$authority" != "legacy" ||
      ("$transition" != "idle" && "$transition" != "prepared" && "$transition" != "preparing") ]]; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_activation_state_requires_recovery"
      return 1
    fi
  fi

  state=$(jq -r '.state' "$helm_state_path")
  if [[ "$state" != "activated" && "$state" != "candidate_ready" && "$state" != "finalized" ]]; then
    prepare_output=$(run_temporary_phase prepare "" false) || {
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_activation_prepare_failed"
      return 1
    }
    receipt=$(jq -er 'select(.status == "prepared") | .receipt' <<<"$prepare_output" 2>/dev/null || true)
    if [[ -z "$receipt" ]]; then
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_activation_prepare_failed"
      return 1
    fi
    write_helm_journal prepared "$receipt"

    audit_output=$(run_temporary_phase audit "$receipt" false) || {
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_relationship_audit_failed"
      return 1
    }
    if ! jq -e '.status == "reconciled" and .truncated == false and (.failures | length) == 0' \
      <<<"$audit_output" >/dev/null 2>&1; then
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_relationship_audit_dirty"
      return 1
    fi
    write_helm_journal audited "$receipt"

    write_main_phase_values "$bridge_image" external 0 false false
    if ! run_main_chart_upgrade "quiesced bridge" || ! wait_for_zero_formbricks_pods; then
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_workload_quiesce_failed"
      return 1
    fi
    write_helm_journal quiesced "$receipt"

    activate_output=$(run_temporary_phase activate "$receipt" true) || {
      status_output=$(get_activation_status_via_chart 2>/dev/null || true)
      authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
      if [[ "$authority" == "spicedb" ]]; then
        write_helm_journal activated "$receipt"
        rollback_helm_after_activation "$receipt" || write_helm_journal manual_recovery_required "$receipt"
      else
        restore_helm_bridge true || true
      fi
      emit_bootstrap_error "helm_activation_failed"
      return 1
    }
    if ! jq -e '.status == "activated"' <<<"$activate_output" >/dev/null 2>&1; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_activation_failed"
      return 1
    fi
    write_helm_journal activated "$receipt"
  fi

  write_main_phase_values "$target_image" external 1 false true
  if ! run_main_chart_upgrade "authoritative candidate" || ! verify_helm_workload_image "$target_image" ||
    ! run_helm_runtime_check spicedb || ! wait_for_helm_application_health; then
    if rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "helm_candidate_failed_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_candidate_failed_rollback_incomplete"
    fi
    return 1
  fi
  write_helm_journal candidate_ready "$receipt"

  finalize_output=$(kubectl_capture exec --namespace "$helm_namespace" "deployment/${helm_deployment_name}" -- \
    formbricks-authzed activation finalize --receipt "$receipt" || true)
  if ! jq -e '.status == "finalized"' <<<"$finalize_output" >/dev/null 2>&1; then
    if rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "helm_finalize_failed_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_finalize_failed_rollback_incomplete"
    fi
    return 1
  fi
  write_helm_journal finalized "$receipt"

  replicas=$(jq -r '.workload.replicas' "$helm_state_path")
  hpa_enabled=$(jq -r '.workload.hpa.enabled' "$helm_state_path")
  # The candidate is held in external migration mode only while the authority transaction is open.
  # Omit the phase override after finalization so the operator's intended value (or the v6 default
  # migration Job) governs every later ordinary Helm upgrade.
  write_main_phase_values "$target_image" "" "$replicas" "$hpa_enabled" true
  if ! run_main_chart_upgrade "restored candidate" || ! verify_helm_workload_image "$target_image" ||
    ! run_helm_runtime_check spicedb || ! wait_for_helm_application_health; then
    if rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "helm_restore_failed_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_restore_failed_rollback_incomplete"
    fi
    return 1
  fi

  if ! helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait; then
    emit_bootstrap_error "helm_temporary_cleanup_failed"
    return 1
  fi
  write_helm_journal completed "$receipt"
  emit_helm_upgrade_success
}

has_local_recovery_journal() {
  local compose_directory default_helm_state

  if [[ "$resolved_install_type" == "one_click" || "$resolved_install_type" == "docker_compose" ]]; then
    compose_directory=$(cd -- "$(dirname -- "$compose_file")" && pwd) || return 1
    [[ -f "${compose_directory}/.formbricks-v6-upgrade-state.json" ]]
    return
  fi

  if [[ "$resolved_install_type" == "helm" ]]; then
    default_helm_state="${PWD}/.formbricks-v6-helm-upgrade-${helm_namespace}-${helm_release}.json"
    [[ -f "${helm_state_path:-$default_helm_state}" ]]
    return
  fi

  return 1
}

verify_existing_docker_target_runtime() {
  local compose_directory runtime_output status_output container_id running_image

  compose_directory=$(cd -- "$(dirname -- "$compose_file")" && pwd) || return 1
  container_id=$(run_docker compose -f "$compose_file" --project-directory "$compose_directory" \
    ps -q formbricks 2>/dev/null) || return 1
  [[ -n "$container_id" ]] || return 1
  running_image=$(run_docker inspect --format '{{.Config.Image}}' "$container_id" 2>/dev/null) || return 1
  [[ "$running_image" == "$target_image" ]] || return 1
  runtime_output=$(run_docker compose -f "$compose_file" --project-directory "$compose_directory" \
    exec -T formbricks formbricks-authzed activation runtime-check 2>/dev/null) || return 1
  jq -e '.status == "ready" and .authority == "spicedb"' <<<"$runtime_output" >/dev/null 2>&1 || return 1
  status_output=$(run_docker compose -f "$compose_file" --project-directory "$compose_directory" \
    exec -T formbricks formbricks-authzed activation status 2>/dev/null) || return 1
  jq -e '.status == "ready" and .authority == "spicedb" and .transition == "idle"' \
    <<<"$status_output" >/dev/null 2>&1 || return 1

  run_docker compose -f "$compose_file" --project-directory "$compose_directory" exec -T formbricks \
    node -e '
      const port = process.env.PORT || "3000";
      fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(5000) })
        .then((response) => process.exit(response.ok ? 0 : 1))
        .catch(() => process.exit(1));
    ' >/dev/null 2>&1
}

verify_existing_helm_target_runtime() {
  local component selector deployments deployment_count deployment_name runtime_output status_output pods

  component=$(jq -r '
    (.componentOverride // empty | select(length > 0)) //
    (.nameOverride // empty | select(length > 0)) //
    "formbricks"
  ' <<<"$helm_inspected_values")
  component="${component:0:63}"
  component="${component%-}"
  selector="app.kubernetes.io/instance=${helm_release},app.kubernetes.io/component=${component}"
  deployments=$(kubectl get deployments --namespace "$helm_namespace" -l "$selector" -o json 2>/dev/null) || return 1
  deployment_count=$(jq -r '.items | length' <<<"$deployments")
  [[ "$deployment_count" == "1" ]] || return 1
  deployment_name=$(jq -er '.items[0].metadata.name' <<<"$deployments") || return 1
  jq -e --arg image "$target_image" --arg container "$deployment_name" \
    '[.items[0].spec.template.spec.containers[] |
      select(.name == $container and .image == $image)] | length == 1' \
    <<<"$deployments" >/dev/null 2>&1 || return 1
  pods=$(kubectl get pods --namespace "$helm_namespace" -l "$selector" -o json 2>/dev/null) || return 1
  HELM_EXPECTED_DIGEST="$target_digest" HELM_APP_CONTAINER="$deployment_name" jq -e '
    [.items[] | select(.metadata.deletionTimestamp == null)] as $pods |
    ($pods | length) > 0 and
    all($pods[];
      any(.status.containerStatuses[]?;
        .name == $ENV.HELM_APP_CONTAINER and .ready == true and
        (.imageID | endswith("@" + $ENV.HELM_EXPECTED_DIGEST))))
  ' <<<"$pods" >/dev/null 2>&1 || return 1

  runtime_output=$(kubectl exec --namespace "$helm_namespace" "deployment/${deployment_name}" -- \
    formbricks-authzed activation runtime-check 2>/dev/null) || return 1
  jq -e '.status == "ready" and .authority == "spicedb"' <<<"$runtime_output" >/dev/null 2>&1 || return 1
  status_output=$(kubectl exec --namespace "$helm_namespace" "deployment/${deployment_name}" -- \
    formbricks-authzed activation status 2>/dev/null) || return 1
  jq -e '.status == "ready" and .authority == "spicedb" and .transition == "idle"' \
    <<<"$status_output" >/dev/null 2>&1 || return 1

  kubectl exec --namespace "$helm_namespace" "deployment/${deployment_name}" -- node -e '
    const port = process.env.PORT || "3000";
    fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(5000) })
      .then((response) => process.exit(response.ok ? 0 : 1))
      .catch(() => process.exit(1));
  ' >/dev/null 2>&1
}

recovery_journal_present=false
if has_local_recovery_journal; then
  recovery_journal_present=true
  add_check "upgrade_recovery_journal_present" "pass"
fi

# A matching major or a caller-supplied version string is not proof that v6 activation completed.
# Only the exact signed target image, its database-backed SpiceDB runtime contract, and the application
# health check can establish that this release needs no cutover. A bound journal takes precedence and
# is handled by the existing recovery state machine.
if [[ "$blocked_count" -eq 0 && "$version_state" == "already_target_release" &&
  "$recovery_journal_present" != "true" && "$action" != "resume" ]]; then
  if [[ "$current_image_digest" != "$target_digest" ]]; then
    add_check "source_target_image_unverified" "blocked"
  elif [[ "$resolved_install_type" == "helm" ]]; then
    if verify_existing_helm_target_runtime; then
      add_check "target_runtime_ready" "pass"
    else
      add_check "target_runtime_unverified" "blocked"
    fi
  elif [[ "$resolved_install_type" == "one_click" || "$resolved_install_type" == "docker_compose" ]]; then
    if verify_existing_docker_target_runtime; then
      add_check "target_runtime_ready" "pass"
    else
      add_check "target_runtime_unverified" "blocked"
    fi
  else
    add_check "target_runtime_unverified" "blocked"
  fi
fi

plan='[]'
status="blocked"
if [[ "$blocked_count" -eq 0 && ( "$action" == "resume" || "$recovery_journal_present" == "true" ) ]]; then
  # A bridge or interrupted candidate already reports v6. The signed-pair-bound journal and database
  # activation state, not the running image's major version, decide whether recovery is complete.
  status="ready"
  plan=$(jq -cn '[
    {order: 1, phase: "resume_from_journal", mutating: true, requiresConfirmation: true},
    {order: 2, phase: "verify_database_authority", mutating: false, requiresConfirmation: false},
    {order: 3, phase: "complete_or_rollback", mutating: true, requiresConfirmation: true}
  ]')
elif [[ "$blocked_count" -eq 0 && "$version_state" == "already_target_release" ]]; then
  status="not_required"
elif [[ "$blocked_count" -eq 0 ]]; then
  status="ready"
  plan=$(jq -cn '[
    {order: 1, phase: "backup", mutating: false, requiresConfirmation: true},
    {order: 2, phase: "prepare_runtime", mutating: true, requiresConfirmation: true},
    {order: 3, phase: "build_relationship_graph", mutating: true, requiresConfirmation: true},
    {order: 4, phase: "fence_and_activate", mutating: true, requiresConfirmation: true},
    {order: 5, phase: "verify", mutating: false, requiresConfirmation: false},
    {order: 6, phase: "remove_temporary_resources", mutating: true, requiresConfirmation: true}
  ]')
fi

preflight_result=$(jq -cn \
  --argjson schemaVersion "$ASSISTANT_SCHEMA_VERSION" \
  --arg status "$status" \
  --arg installType "$resolved_install_type" \
  --arg currentVersion "$current_version" \
  --arg databaseMode "$database_mode" \
  --argjson currentImagePinned "$current_image_pinned" \
  --arg currentImageDigest "$current_image_digest" \
  --argjson authzedConfigured "$authzed_configured" \
  --arg releaseVersion "$release_version" \
  --arg manifestDigest "$manifest_digest" \
  --arg bridgeDigest "$bridge_digest" \
  --arg bridgeRuntimeManifestDigest "$bridge_runtime_manifest_digest" \
  --arg formbricksChart "$formbricks_chart" \
  --arg targetDigest "$target_digest" \
  --arg targetRuntimeManifestDigest "$target_runtime_manifest_digest" \
  --arg upgradeChart "$upgrade_chart" \
  --argjson warningCount "$warning_count" \
  --argjson checks "$checks" \
  --argjson plan "$plan" \
  '{
    schemaVersion: $schemaVersion,
    status: $status,
    mutating: false,
    installation: {
      type: $installType,
      currentVersion: (if $currentVersion == "" then null else $currentVersion end),
      currentImagePinned: $currentImagePinned,
      currentImageDigest: (if $currentImageDigest == "" then null else $currentImageDigest end),
      databaseMode: $databaseMode,
      authzedConfigured: $authzedConfigured
    },
    release: {
      version: (if $releaseVersion == "" then null else $releaseVersion end),
      manifestDigest: (if $manifestDigest == "" then null else ("sha256:" + $manifestDigest) end),
      bridgeImageDigest: (if $bridgeDigest == "" then null else $bridgeDigest end),
      bridgeRuntimeManifestDigest: (if $bridgeRuntimeManifestDigest == "" then null else $bridgeRuntimeManifestDigest end),
      formbricksChart: (if $formbricksChart == "" then null else $formbricksChart end),
      targetImageDigest: (if $targetDigest == "" then null else $targetDigest end),
      targetRuntimeManifestDigest: (if $targetRuntimeManifestDigest == "" then null else $targetRuntimeManifestDigest end),
      upgradeChart: (if $upgradeChart == "" then null else $upgradeChart end)
    },
    warningCount: $warningCount,
    checks: $checks,
    plan: $plan
  }')

if [[ "$status" == "blocked" ]]; then
  printf '%s\n' "$preflight_result"
  exit 2
fi

if [[ "$action" == "preflight" ]]; then
  printf '%s\n' "$preflight_result"
  exit 0
fi

if [[ "$status" != "ready" && ! ( "$status" == "not_required" && "$install_type" == "docker" ) ]]; then
  printf '%s\n' "$preflight_result"
  exit 0
fi

if [[ "$resolved_install_type" == "helm" ]]; then
  if ! acquire_helm_upgrade_lock; then
    emit_bootstrap_error "upgrade_already_running"
    exit 2
  fi
  trap release_upgrade_lock EXIT
  execute_helm_upgrade
  exit $?
fi

docker_lock_directory=$(cd -- "$(dirname -- "$compose_file")" && pwd) || {
  emit_bootstrap_error "upgrade_lock_unavailable"
  exit 2
}
if ! acquire_docker_upgrade_lock "$docker_lock_directory"; then
  emit_bootstrap_error "upgrade_already_running"
  exit 2
fi
trap release_upgrade_lock EXIT
execute_docker_upgrade
