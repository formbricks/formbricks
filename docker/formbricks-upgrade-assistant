#!/usr/bin/env bash

set -euo pipefail

readonly ASSISTANT_SCHEMA_VERSION=1
readonly DEFAULT_MANIFEST_NAME="formbricks-upgrade-manifest.json"
readonly DEFAULT_CHECKSUMS_NAME="formbricks-upgrade-checksums.txt"
readonly DEFAULT_DOCKER_OVERLAY_NAME="formbricks-authzed-overlay.yml"
readonly DEFAULT_POSTGRES_BOOTSTRAP_NAME="authzed-postgres-bootstrap.sh"

action="preflight"
manifest_path=""
docker_overlay_path=""
postgres_bootstrap_path=""
checksums_path=""
formbricks_chart_path=""
upgrade_chart_path=""
spicedb_crd_path=""
helm_values_path=""
helm_state_path=""
install_type="auto"
installation_path="."
helm_release=""
helm_namespace=""
current_version_override=""
confirmed=false
backup_confirmed=false
gitops_paused=false

checks='[]'
blocked_count=0
warning_count=0

docker_command=(docker)
if [[ "${FORMBRICKS_DOCKER_USE_SUDO:-false}" == "true" ]]; then
  docker_command=(sudo docker)
fi

run_docker() {
  "${docker_command[@]}" "$@"
}

emit_bootstrap_error() {
  local code="$1"

  printf '{"schemaVersion":1,"status":"blocked","mutating":false,"checks":[{"code":"%s","status":"blocked"}],"plan":[]}\n' "$code"
}

if ! command -v jq >/dev/null 2>&1; then
  emit_bootstrap_error "jq_missing"
  exit 2
fi

add_check() {
  local code="$1"
  local status="$2"

  checks=$(jq -cn --argjson current "$checks" --arg code "$code" --arg status "$status" \
    '$current + [{code: $code, status: $status}]')

  case "$status" in
    blocked) blocked_count=$((blocked_count + 1)) ;;
    warning) warning_count=$((warning_count + 1)) ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
Usage: formbricks-upgrade-assistant [preflight|execute|resume] [options]

Read-only options:
  --manifest PATH          Signed release manifest (defaults beside this executable)
  --install-type TYPE      auto, docker, or helm (default: auto)
  --path PATH              Docker Compose file or installation directory
  --helm-release NAME      Helm release name (requires --namespace)
  --namespace NAME         Helm namespace (requires --helm-release)
  --current-version VER    Override a version that cannot be detected safely
  --overlay PATH           Signed Docker AuthZed overlay (execute only)
  --bootstrap-helper PATH  Signed PostgreSQL bootstrap helper (execute only)
  --checksums PATH         Verified signed checksum set (Helm execute/resume only)
  --chart PATH             Release-matched Formbricks chart archive (Helm only)
  --upgrade-chart PATH     Release-matched temporary upgrade chart archive (Helm only)
  --spicedb-crd PATH       Release-signed SpiceDBCluster CRD (Helm only)
  --helm-values PATH       Cutover-only AuthZed values as a JSON object (Helm only)
  --state-file PATH        0600 Helm execution journal (Helm only)
  --backup-confirmed       Acknowledge a verified database backup
  --gitops-paused          Certify a detected controller for this Helm release is paused
  --yes                    Confirm the mutating cutover
  --help                    Show this help
EOF
}

fail_usage() {
  usage
  exit 64
}

if [[ "${1:-}" == "preflight" || "${1:-}" == "execute" || "${1:-}" == "resume" ]]; then
  action="$1"
  shift
elif [[ -n "${1:-}" && "${1:-}" != --* ]]; then
  fail_usage
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --manifest)
      [[ $# -ge 2 ]] || fail_usage
      manifest_path="$2"
      shift 2
      ;;
    --install-type)
      [[ $# -ge 2 ]] || fail_usage
      install_type="$2"
      shift 2
      ;;
    --path)
      [[ $# -ge 2 ]] || fail_usage
      installation_path="$2"
      shift 2
      ;;
    --helm-release)
      [[ $# -ge 2 ]] || fail_usage
      helm_release="$2"
      shift 2
      ;;
    --namespace)
      [[ $# -ge 2 ]] || fail_usage
      helm_namespace="$2"
      shift 2
      ;;
    --current-version)
      [[ $# -ge 2 ]] || fail_usage
      current_version_override="$2"
      shift 2
      ;;
    --overlay)
      [[ $# -ge 2 ]] || fail_usage
      docker_overlay_path="$2"
      shift 2
      ;;
    --bootstrap-helper)
      [[ $# -ge 2 ]] || fail_usage
      postgres_bootstrap_path="$2"
      shift 2
      ;;
    --checksums)
      [[ $# -ge 2 ]] || fail_usage
      checksums_path="$2"
      shift 2
      ;;
    --chart)
      [[ $# -ge 2 ]] || fail_usage
      formbricks_chart_path="$2"
      shift 2
      ;;
    --upgrade-chart)
      [[ $# -ge 2 ]] || fail_usage
      upgrade_chart_path="$2"
      shift 2
      ;;
    --spicedb-crd)
      [[ $# -ge 2 ]] || fail_usage
      spicedb_crd_path="$2"
      shift 2
      ;;
    --helm-values)
      [[ $# -ge 2 ]] || fail_usage
      helm_values_path="$2"
      shift 2
      ;;
    --state-file)
      [[ $# -ge 2 ]] || fail_usage
      helm_state_path="$2"
      shift 2
      ;;
    --backup-confirmed)
      backup_confirmed=true
      shift
      ;;
    --gitops-paused)
      gitops_paused=true
      shift
      ;;
    --yes)
      confirmed=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *) fail_usage ;;
  esac
done

case "$install_type" in
  auto|docker|helm) ;;
  *) fail_usage ;;
esac

if [[ -n "$helm_release" || -n "$helm_namespace" ]]; then
  [[ -n "$helm_release" && -n "$helm_namespace" ]] || fail_usage
  [[ "$install_type" == "auto" || "$install_type" == "helm" ]] || fail_usage
  install_type="helm"
fi

if [[ -z "$manifest_path" ]]; then
  script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  manifest_path="${script_dir}/${DEFAULT_MANIFEST_NAME}"
fi
bundle_dir=$(cd -- "$(dirname -- "$manifest_path")" 2>/dev/null && pwd || true)
if [[ -z "$docker_overlay_path" && -n "$bundle_dir" ]]; then
  docker_overlay_path="${bundle_dir}/${DEFAULT_DOCKER_OVERLAY_NAME}"
fi
if [[ -z "$postgres_bootstrap_path" && -n "$bundle_dir" ]]; then
  postgres_bootstrap_path="${bundle_dir}/${DEFAULT_POSTGRES_BOOTSTRAP_NAME}"
fi
if [[ -z "$checksums_path" && -n "$bundle_dir" ]]; then
  checksums_path="${bundle_dir}/${DEFAULT_CHECKSUMS_NAME}"
fi
if [[ -z "$spicedb_crd_path" && -n "$bundle_dir" ]]; then
  spicedb_crd_path="${bundle_dir}/authzed.com_spicedbclusters.yaml"
fi

readonly semver_pattern='^[vV]?([0-9]+)\.([0-9]+)\.([0-9]+)(-[0-9A-Za-z.-]+)?$'
readonly digest_pattern='^sha256:[0-9a-f]{64}$'
readonly image_pattern='^ghcr\.io/formbricks/formbricks@sha256:[0-9a-f]{64}$'
readonly postgres_bootstrap_image_pattern='^pgvector/pgvector@sha256:[0-9a-f]{64}$'
readonly spicedb_image_pattern='^authzed/spicedb@sha256:[0-9a-f]{64}$'

normalize_version() {
  local version="$1"
  version="${version#[vV]}"
  printf '%s' "$version"
}

version_core() {
  local version
  version=$(normalize_version "$1")
  version="${version%%+*}"
  printf '%s' "${version%%-*}"
}

version_is_at_least() {
  local actual_core minimum_core actual_major actual_minor actual_patch minimum_major minimum_minor minimum_patch
  actual_core=$(version_core "$1")
  minimum_core=$(version_core "$2")
  IFS=. read -r actual_major actual_minor actual_patch <<<"$actual_core"
  IFS=. read -r minimum_major minimum_minor minimum_patch <<<"$minimum_core"

  ((10#$actual_major > 10#$minimum_major)) && return 0
  ((10#$actual_major < 10#$minimum_major)) && return 1
  ((10#$actual_minor > 10#$minimum_minor)) && return 0
  ((10#$actual_minor < 10#$minimum_minor)) && return 1
  ((10#$actual_patch >= 10#$minimum_patch))
}

extract_version_from_image() {
  local image="$1"
  local without_digest tag

  without_digest="${image%@*}"
  tag="${without_digest##*:}"
  if [[ "$tag" =~ $semver_pattern ]]; then
    normalize_version "$tag"
  fi
}

extract_digest_from_image() {
  local image="$1"
  local digest=""

  if [[ "$image" == *@* ]]; then
    digest="${image##*@}"
  fi
  if [[ "$digest" =~ $digest_pattern ]]; then
    printf '%s' "$digest"
  fi
}

if [[ -n "$current_version_override" && ! "$current_version_override" =~ $semver_pattern ]]; then
  add_check "current_version_override_invalid" "blocked"
  current_version_override=""
fi

manifest_valid=false
release_version=""
minimum_source_version=""
bridge_image=""
target_image=""
bridge_digest=""
target_digest=""
bridge_runtime_manifest_digest=""
target_runtime_manifest_digest=""
formbricks_chart=""
upgrade_chart=""
docker_overlay_digest=""
postgres_bootstrap_digest=""
postgres_bootstrap_image=""
spicedb_image=""
manifest_digest=""

if [[ ! -f "$manifest_path" ]]; then
  add_check "release_manifest_missing" "blocked"
elif ! jq -e '
    type == "object" and
    .schemaVersion == 1 and
    (.releaseVersion | type == "string") and
    (.sourceRevision | type == "string") and
    (.minimumSourceVersion | type == "string") and
    (.supportedPreActivationVersions | type == "array") and
    (.supportedPreActivationVersions | all(type == "string")) and
    (.supportedPreActivationVersions == (.supportedPreActivationVersions | sort | unique)) and
    (.artifacts | type == "object") and
    (.artifacts.bridgeImage | type == "string") and
    (.artifacts.bridgeRuntimeManifestDigest | type == "string") and
    (.artifacts.formbricksChart | type == "string") and
    (.artifacts.dockerAuthzedOverlaySha256 | type == "string") and
    (.artifacts.authzedPostgresBootstrapSha256 | type == "string") and
    (.artifacts.postgresBootstrapImage | type == "string") and
    (.artifacts.spicedbImage | type == "string") and
    (.artifacts.spicedbClusterCrdSha256 | type == "string") and
    (.artifacts.targetImage | type == "string") and
    (.artifacts.targetRuntimeManifestDigest | type == "string") and
    (.artifacts.upgradeChart | type == "string") and
    (.supportedInstallTypes == ["docker_compose", "helm", "one_click"])
  ' "$manifest_path" >/dev/null 2>&1; then
  add_check "release_manifest_invalid" "blocked"
else
  release_version=$(jq -er '.releaseVersion' "$manifest_path")
  minimum_source_version=$(jq -er '.minimumSourceVersion' "$manifest_path")
  supported_pre_activation_versions=$(jq -cer '.supportedPreActivationVersions' "$manifest_path")
  bridge_image=$(jq -er '.artifacts.bridgeImage' "$manifest_path")
  bridge_runtime_manifest_digest=$(jq -er '.artifacts.bridgeRuntimeManifestDigest' "$manifest_path")
  formbricks_chart=$(jq -er '.artifacts.formbricksChart' "$manifest_path")
  docker_overlay_digest=$(jq -er '.artifacts.dockerAuthzedOverlaySha256' "$manifest_path")
  postgres_bootstrap_digest=$(jq -er '.artifacts.authzedPostgresBootstrapSha256' "$manifest_path")
  postgres_bootstrap_image=$(jq -er '.artifacts.postgresBootstrapImage' "$manifest_path")
  spicedb_image=$(jq -er '.artifacts.spicedbImage' "$manifest_path")
  spicedb_crd_digest=$(jq -er '.artifacts.spicedbClusterCrdSha256' "$manifest_path")
  target_image=$(jq -er '.artifacts.targetImage' "$manifest_path")
  target_runtime_manifest_digest=$(jq -er '.artifacts.targetRuntimeManifestDigest' "$manifest_path")
  upgrade_chart=$(jq -er '.artifacts.upgradeChart' "$manifest_path")
  source_revision=$(jq -er '.sourceRevision' "$manifest_path")
  release_major=$(version_core "$release_version")
  release_major="${release_major%%.*}"
  minimum_source_major=$(version_core "$minimum_source_version")
  minimum_source_major="${minimum_source_major%%.*}"

  pre_activation_versions_valid=true
  while IFS= read -r pre_activation_version; do
    pre_activation_core=$(version_core "$pre_activation_version")
    if [[ ! "$pre_activation_version" =~ $semver_pattern ]] ||
      [[ "$pre_activation_version" != "$(normalize_version "$pre_activation_version")" ]] ||
      [[ "$pre_activation_version" != *-* ]] ||
      [[ "$pre_activation_version" == "$release_version" ]] ||
      [[ "$pre_activation_core" != "$(version_core "$release_version")" ]]; then
      pre_activation_versions_valid=false
    fi
  done < <(jq -r '.[]' <<<"$supported_pre_activation_versions")

  if [[ "$release_version" =~ $semver_pattern ]] &&
    [[ "$minimum_source_version" =~ $semver_pattern ]] &&
    [[ "$pre_activation_versions_valid" == "true" ]] &&
    [[ "$release_major" == "6" ]] &&
    [[ "$minimum_source_major" == "5" ]] &&
    [[ "$source_revision" =~ ^[0-9a-f]{40}$ ]] &&
    [[ "$bridge_image" =~ $image_pattern ]] &&
    [[ "$target_image" =~ $image_pattern ]] &&
    [[ "$bridge_runtime_manifest_digest" =~ $digest_pattern ]] &&
    [[ "$docker_overlay_digest" =~ $digest_pattern ]] &&
    [[ "$postgres_bootstrap_digest" =~ $digest_pattern ]] &&
    [[ "$postgres_bootstrap_image" =~ $postgres_bootstrap_image_pattern ]] &&
    [[ "$spicedb_image" =~ $spicedb_image_pattern ]] &&
    [[ "$spicedb_crd_digest" =~ $digest_pattern ]] &&
    [[ "$target_runtime_manifest_digest" =~ $digest_pattern ]] &&
    [[ "$formbricks_chart" == "formbricks-${release_version#[vV]}.tgz" ]] &&
    [[ "$upgrade_chart" == "formbricks-upgrade-${release_version#[vV]}.tgz" ]] &&
    [[ "$bridge_image" != "$target_image" ]]; then
    bridge_digest=$(extract_digest_from_image "$bridge_image")
    target_digest=$(extract_digest_from_image "$target_image")
    manifest_valid=true
    add_check "release_manifest_valid" "pass"
    add_check "release_images_immutable" "pass"
  else
    add_check "release_manifest_invalid" "blocked"
  fi
fi

if command -v sha256sum >/dev/null 2>&1; then
  manifest_digest=$(sha256sum "$manifest_path" 2>/dev/null | awk '{print $1}' || true)
elif command -v shasum >/dev/null 2>&1; then
  manifest_digest=$(shasum -a 256 "$manifest_path" 2>/dev/null | awk '{print $1}' || true)
else
  add_check "sha256_tool_missing" "blocked"
fi

resolve_compose_file() {
  local requested="$1"
  local candidate

  if [[ -f "$requested" ]]; then
    printf '%s' "$requested"
    return 0
  fi

  for candidate in \
    "$requested/docker-compose.yml" \
    "$requested/compose.yml" \
    "$requested/compose.yaml" \
    "$requested/formbricks/docker-compose.yml" \
    "$requested/formbricks/compose.yml" \
    "$requested/formbricks/compose.yaml"; do
    if [[ -f "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  return 1
}

compose_file=""
if compose_file=$(resolve_compose_file "$installation_path" 2>/dev/null); then
  compose_detected=true
else
  compose_detected=false
fi

if [[ "$install_type" == "auto" ]]; then
  if [[ "$compose_detected" == "true" ]]; then
    install_type="docker"
  elif command -v helm >/dev/null 2>&1; then
    install_type="helm"
  else
    add_check "installation_not_detected" "blocked"
    install_type="unknown"
  fi
fi

resolved_install_type="unknown"
current_version=""
current_image_pinned=false
current_image_digest=""
database_mode="unknown"
authzed_configured=false
helm_inspected_values='{}'
helm_release_revision=""
helm_release_status=""
helm_operator_values_content='{}'
helm_desired_authzed_mode="selfHosted"
helm_operator_install="true"
helm_operator_install_explicit=false
helm_database_binding_error=""
helm_database_source="chart_default"
helm_database_has_migrate=false
helm_database_secret=""
helm_database_key=""
helm_migrate_database_key="MIGRATE_DATABASE_URL"
spicedb_crd_install_required=false

normalize_safe_helm_operator_values() {
  jq -cer '
    select(
      type == "object" and
      ((keys - ["authzed"]) | length) == 0 and
      ((.authzed // {}) | type) == "object" and
      (((.authzed // {}) | keys - ["mode", "endpoint", "insecure", "systemKey", "auth", "datastore", "operator"]) | length) == 0 and
      ((.authzed.mode? == null) or (.authzed.mode | IN("selfHosted", "external"))) and
      ((.authzed.endpoint? == null) or (.authzed.endpoint | type == "string")) and
      ((.authzed.insecure? == null) or (.authzed.insecure | type == "boolean")) and
      ((.authzed.systemKey? == null) or (.authzed.systemKey | type == "string")) and
      ((.authzed.auth? == null) or (
        (.authzed.auth | type == "object") and
        ((.authzed.auth | keys - ["existingSecret", "tokenKey"]) | length) == 0 and
        all(.authzed.auth[]; type == "string")
      )) and
      ((.authzed.datastore? == null) or (
        (.authzed.datastore | type == "object") and
        ((.authzed.datastore | keys - ["existingSecret", "uriKey"]) | length) == 0 and
        all(.authzed.datastore[]; type == "string")
      )) and
      ((.authzed.operator? == null) or (
        (.authzed.operator | type == "object") and
        ((.authzed.operator | keys - ["install"]) | length) == 0 and
        ((.authzed.operator.install? == null) or (.authzed.operator.install | type == "boolean"))
      ))
    )
  ' 2>/dev/null
}

resolve_helm_authzed_mode() {
  local merged
  merged=$(jq -cn --argjson current "$helm_inspected_values" \
    --argjson operator "$helm_operator_values_content" '$current * $operator') || return 1
  helm_desired_authzed_mode=$(jq -er '.authzed.mode // "selfHosted" | select(IN("selfHosted", "external"))' \
    <<<"$merged") || return 1
  helm_operator_install=$(jq -er 'if .authzed.operator.install == false then "false" else "true" end' \
    <<<"$merged") || return 1
  helm_operator_install_explicit=$(jq -er '
    if ((.authzed.operator? | type) == "object" and (.authzed.operator | has("install")))
    then "true" else "false" end
  ' <<<"$merged") || return 1
}

resolve_helm_database_binding() {
  local component selector deployments deployment_count deployment

  validate_helm_database_source_shape || return 1
  [[ "$helm_database_source" == "secret_ref" ]] || return 0

  component=$(jq -r '
    (.componentOverride // empty | select(length > 0)) //
    (.nameOverride // empty | select(length > 0)) //
    "formbricks"
  ' <<<"$helm_inspected_values") || return 1
  component="${component:0:63}"
  component="${component%-}"
  selector="app.kubernetes.io/instance=${helm_release},app.kubernetes.io/component=${component}"
  deployments=$(kubectl get deployments --namespace "$helm_namespace" -l "$selector" -o json \
    2>/dev/null) || {
    helm_database_binding_error="helm_database_source_unresolvable"
    return 1
  }
  deployment_count=$(jq -r '.items | length' <<<"$deployments") || return 1
  if [[ "$deployment_count" != "1" ]]; then
    helm_database_binding_error="helm_database_source_unresolvable"
    return 1
  fi
  deployment=$(jq -c '.items[0]' <<<"$deployments") || return 1
  resolve_helm_database_binding_from_deployment "$deployment"
}

validate_helm_database_source_shape() {
  local database_env database_present env_from_count migrate_env migrate_present

  helm_database_binding_error=""
  helm_database_source="chart_default"
  helm_database_has_migrate=false
  helm_database_secret=""
  helm_database_key=""
  helm_migrate_database_key="MIGRATE_DATABASE_URL"

  database_present=$(jq -r '((.deployment.env // {}) | type == "object") and ((.deployment.env // {}) | has("DATABASE_URL"))' \
    <<<"$helm_inspected_values") || return 1
  migrate_present=$(jq -r '((.deployment.env // {}) | type == "object") and ((.deployment.env // {}) | has("MIGRATE_DATABASE_URL"))' \
    <<<"$helm_inspected_values") || return 1
  env_from_count=$(jq -r '(.deployment.envFrom // {}) | length' <<<"$helm_inspected_values") || return 1

  if [[ "$database_present" != "true" ]]; then
    if [[ "$env_from_count" != "0" ]]; then
      helm_database_binding_error="helm_database_source_ambiguous"
      return 1
    fi
    if [[ "$migrate_present" == "true" ]]; then
      helm_database_binding_error="helm_database_source_unsupported"
      return 1
    fi
    return 0
  fi

  # Kubernetes does not materialize keys supplied through envFrom in the Deployment's explicit
  # container env list. If an envFrom source is present, a hidden MIGRATE_DATABASE_URL could override
  # the application database binding while remaining impossible for the assistant to bind and journal.
  # Require both database endpoints to be explicit before any upgrade mutation in that shape.
  if [[ "$env_from_count" != "0" && "$migrate_present" != "true" ]]; then
    helm_database_binding_error="helm_database_source_ambiguous"
    return 1
  fi

  database_env=$(jq -c '.deployment.env.DATABASE_URL' <<<"$helm_inspected_values") || return 1
  if ! jq -e '
    select(type == "object") |
    .valueFrom.secretKeyRef |
    select(type == "object" and ((.optional // false) == false)) |
    select((.name | type == "string" and length > 0) and (.key | type == "string" and length > 0))
  ' <<<"$database_env" >/dev/null 2>&1; then
    helm_database_binding_error="helm_database_source_unsupported"
    return 1
  fi

  if [[ "$migrate_present" == "true" ]]; then
    migrate_env=$(jq -c '.deployment.env.MIGRATE_DATABASE_URL' <<<"$helm_inspected_values") || return 1
    if ! jq -e '
      select(type == "object") |
      .valueFrom.secretKeyRef |
      select(type == "object" and ((.optional // false) == false)) |
      select((.name | type == "string" and length > 0) and (.key | type == "string" and length > 0))
    ' <<<"$migrate_env" >/dev/null 2>&1; then
      helm_database_binding_error="helm_database_source_unsupported"
      return 1
    fi
    helm_database_has_migrate=true
  fi

  helm_database_source="secret_ref"
}

resolve_helm_database_binding_from_deployment() {
  local deployment="$1"
  local container database_env database_secret database_key migrate_env migrate_secret migrate_key

  [[ "$helm_database_source" == "secret_ref" ]] || return 0
  container=$(jq -er '.metadata.name | select(type == "string" and length > 0)' <<<"$deployment") || {
    helm_database_binding_error="helm_database_source_unresolvable"
    return 1
  }
  database_env=$(jq -cer --arg container "$container" '
    [.spec.template.spec.containers[]? | select(.name == $container)] |
    select(length == 1) | .[0].env // [] |
    [.[] | select(.name == "DATABASE_URL")] | select(length == 1) | .[0]
  ' <<<"$deployment" 2>/dev/null) || {
    helm_database_binding_error="helm_database_source_unresolvable"
    return 1
  }
  database_secret=$(jq -er '
    select((keys | sort) == ["name", "valueFrom"]) |
    .valueFrom | select((keys | sort) == ["secretKeyRef"]) |
    .secretKeyRef |
    select(((.optional // false) == false) and ((keys - ["key", "name", "optional"]) | length == 0)) |
    .name | select(type == "string" and test("^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"))
  ' <<<"$database_env" 2>/dev/null) || {
    helm_database_binding_error="helm_database_source_unsupported"
    return 1
  }
  database_key=$(jq -er '
    .valueFrom.secretKeyRef.key |
    select(type == "string" and length <= 253 and test("^[A-Za-z0-9._-]+$"))
  ' <<<"$database_env" 2>/dev/null) || {
    helm_database_binding_error="helm_database_source_unsupported"
    return 1
  }

  if [[ "$helm_database_has_migrate" == "true" ]]; then
    migrate_env=$(jq -cer --arg container "$container" '
      [.spec.template.spec.containers[]? | select(.name == $container)] |
      select(length == 1) | .[0].env // [] |
      [.[] | select(.name == "MIGRATE_DATABASE_URL")] | select(length == 1) | .[0]
    ' <<<"$deployment" 2>/dev/null) || {
      helm_database_binding_error="helm_database_source_unresolvable"
      return 1
    }
    migrate_secret=$(jq -er '
      select((keys | sort) == ["name", "valueFrom"]) |
      .valueFrom | select((keys | sort) == ["secretKeyRef"]) |
      .secretKeyRef |
      select(((.optional // false) == false) and ((keys - ["key", "name", "optional"]) | length == 0)) |
      .name | select(type == "string" and length > 0)
    ' <<<"$migrate_env" 2>/dev/null) || {
      helm_database_binding_error="helm_database_source_unsupported"
      return 1
    }
    migrate_key=$(jq -er '
      .valueFrom.secretKeyRef.key |
      select(type == "string" and length <= 253 and test("^[A-Za-z0-9._-]+$"))
    ' <<<"$migrate_env" 2>/dev/null) || {
      helm_database_binding_error="helm_database_source_unsupported"
      return 1
    }
    if [[ "$migrate_secret" != "$database_secret" ]]; then
      helm_database_binding_error="helm_database_source_unsupported"
      return 1
    fi
    helm_migrate_database_key="$migrate_key"
  fi

  helm_database_secret="$database_secret"
  helm_database_key="$database_key"
}

load_helm_database_binding_from_journal() {
  local journal="$1"
  local source

  source=$(jq -er '.databaseBinding.source' <<<"$journal") || return 1
  helm_database_source="$source"
  if [[ "$source" == "chart_default" ]]; then
    helm_database_secret=""
    helm_database_key=""
    helm_migrate_database_key="MIGRATE_DATABASE_URL"
    return 0
  fi
  [[ "$source" == "secret_ref" ]] || return 1
  helm_database_secret=$(jq -er '.databaseBinding.secretName' <<<"$journal") || return 1
  helm_database_key=$(jq -er '.databaseBinding.urlKey' <<<"$journal") || return 1
  helm_migrate_database_key=$(jq -er '.databaseBinding.migrateUrlKey' <<<"$journal") || return 1
}

parse_safe_helm_operator_values() {
  helm_operator_values_content='{}'
  if [[ -n "$helm_values_path" ]]; then
    [[ -f "$helm_values_path" ]] || return 1
    helm_operator_values_content=$(normalize_safe_helm_operator_values <"$helm_values_path") || return 1
  fi
  resolve_helm_authzed_mode
}

spicedb_crd_contract_is_compatible() {
  jq -e '
    .apiVersion == "apiextensions.k8s.io/v1" and
    .kind == "CustomResourceDefinition" and
    .metadata.name == "spicedbclusters.authzed.com" and
    .spec.group == "authzed.com" and
    .spec.scope == "Namespaced" and
    .spec.names.kind == "SpiceDBCluster" and
    .spec.names.plural == "spicedbclusters" and
    ([.spec.versions[]? | select(.name == "v1alpha1" and .served == true)] | length == 1) and
    ([.spec.versions[]? | select(.name == "v1alpha1" and .served == true)][0] as $version |
      $version.schema.openAPIV3Schema.properties.spec.properties as $spec |
      $spec.version.type == "string" and
      $spec.channel.type == "string" and
      $spec.config.type == "object" and
      $spec.patches.type == "array" and
      $spec.credentials.properties.datastoreURI.properties.secretName.type == "string" and
      $spec.credentials.properties.datastoreURI.properties.key.type == "string" and
      $spec.credentials.properties.presharedKey.properties.secretName.type == "string" and
      $spec.credentials.properties.presharedKey.properties.key.type == "string" and
      ($version.subresources.status | type == "object"))
  ' >/dev/null 2>&1
}

spicedb_crd_is_compatible() {
  local document
  document=$(cat) || return 1
  spicedb_crd_contract_is_compatible <<<"$document" &&
    jq -e 'any(.status.conditions[]?; .type == "Established" and .status == "True")' \
      <<<"$document" >/dev/null 2>&1
}

inspect_spicedb_crd_requirement() {
  local can_get existing_crd can_create

  [[ "$helm_desired_authzed_mode" == "selfHosted" ]] || return 0

  can_get=$(kubectl auth can-i get customresourcedefinitions.apiextensions.k8s.io 2>/dev/null || true)
  if [[ "$can_get" != "yes" ]]; then
    add_check "spicedb_crd_read_permission_missing" "blocked"
    return 1
  fi
  if ! existing_crd=$(kubectl get customresourcedefinition spicedbclusters.authzed.com \
    --ignore-not-found -o json 2>/dev/null); then
    add_check "spicedb_crd_lookup_failed" "blocked"
    return 1
  fi

  if [[ -n "$existing_crd" ]]; then
    if spicedb_crd_is_compatible <<<"$existing_crd"; then
      # A pre-existing cluster-scoped CRD may belong to a shared SpiceDB operator. Helm defaults do
      # not prove ownership, so require an affirmative operator choice on the first run. Resume is
      # safe because its signed, release-bound journal is validated before any cluster mutation.
      if [[ "$action" != "resume" && "$helm_operator_install_explicit" != "true" ]]; then
        add_check "spicedb_operator_ownership_ambiguous" "blocked"
        return 1
      fi
      add_check "spicedb_crd_compatible" "pass"
      return 0
    fi
    add_check "spicedb_crd_incompatible" "blocked"
    return 1
  fi

  if [[ "$helm_operator_install" != "true" ]]; then
    add_check "spicedb_operator_crd_missing" "blocked"
    return 1
  fi
  can_create=$(kubectl auth can-i create customresourcedefinitions.apiextensions.k8s.io 2>/dev/null || true)
  if [[ "$can_create" != "yes" ]]; then
    add_check "spicedb_crd_create_permission_missing" "blocked"
    return 1
  fi
  spicedb_crd_install_required=true
  add_check "spicedb_crd_installable" "pass"
}

inspect_docker_installation() {
  local compose_dir rendered image container_id inspected_version packaged_version

  if ! command -v docker >/dev/null 2>&1; then
    add_check "docker_missing" "blocked"
    return
  fi
  if ! run_docker compose version >/dev/null 2>&1; then
    add_check "docker_compose_missing" "blocked"
    return
  fi
  add_check "docker_compose_available" "pass"

  if [[ "$compose_detected" != "true" ]]; then
    add_check "compose_file_missing" "blocked"
    return
  fi

  compose_dir=$(cd -- "$(dirname -- "$compose_file")" && pwd)
  if ! rendered=$(run_docker compose -f "$compose_file" --project-directory "$compose_dir" config --format json 2>/dev/null); then
    add_check "compose_config_invalid" "blocked"
    return
  fi
  if ! jq -e '.services.formbricks | type == "object"' <<<"$rendered" >/dev/null 2>&1; then
    add_check "formbricks_service_missing" "blocked"
    return
  fi
  add_check "deployment_config_readable" "pass"

  if jq -e '.services.traefik | type == "object"' <<<"$rendered" >/dev/null 2>&1; then
    resolved_install_type="one_click"
  else
    resolved_install_type="docker_compose"
  fi

  image=$(jq -er '.services.formbricks.image // empty' <<<"$rendered" 2>/dev/null || true)
  current_image_digest=$(extract_digest_from_image "$image")
  if [[ -n "$current_image_digest" ]]; then
    current_image_pinned=true
  else
    add_check "current_image_mutable" "warning"
  fi

  if [[ -n "$current_version_override" ]]; then
    current_version=$(normalize_version "$current_version_override")
  else
    current_version=$(extract_version_from_image "$image")
    if [[ -z "$current_version" ]]; then
      container_id=$(run_docker compose -f "$compose_file" --project-directory "$compose_dir" ps -q formbricks 2>/dev/null || true)
      if [[ -n "$container_id" ]]; then
        inspected_version=$(run_docker inspect --format '{{ index .Config.Labels "org.opencontainers.image.version" }}' "$container_id" 2>/dev/null || true)
        if [[ "$inspected_version" =~ $semver_pattern ]]; then
          current_version=$(normalize_version "$inspected_version")
        else
          packaged_version=$(run_docker exec "$container_id" node -p \
            'JSON.parse(require("fs").readFileSync("/home/nextjs/package.json", "utf8")).version' \
            2>/dev/null || true)
          if [[ "$packaged_version" =~ $semver_pattern ]]; then
            current_version=$(normalize_version "$packaged_version")
          fi
        fi
      fi
    fi
  fi

  if jq -e '
      (.services.postgres | type == "object") and
      ((.services.postgres.environment.POSTGRES_USER // "postgres") == "postgres") and
      (.services.formbricks.environment.DATABASE_URL | type == "string") and
      (.services.formbricks.environment.DATABASE_URL |
        test("^postgres(ql)?://[^/]+@postgres(:5432)?/"))
    ' <<<"$rendered" >/dev/null 2>&1; then
    database_mode="bundled"
    add_check "database_configuration_present" "pass"
  elif jq -e '.services.formbricks.environment.DATABASE_URL | type == "string" and length > 0' <<<"$rendered" >/dev/null 2>&1; then
    database_mode="external"
    add_check "database_configuration_present" "pass"
  else
    add_check "database_configuration_missing" "blocked"
  fi

  if jq -e '.services.spicedb and .services["authzed-ops"]' <<<"$rendered" >/dev/null 2>&1; then
    authzed_configured=true
  fi
}

inspect_helm_installation() {
  local releases release_count release_data release_status values can_read can_create_jobs can_patch
  local helm_cli_version helm_semver

  if ! command -v helm >/dev/null 2>&1; then
    add_check "helm_missing" "blocked"
    return
  fi
  if ! command -v kubectl >/dev/null 2>&1; then
    add_check "kubectl_missing" "blocked"
    return
  fi
  helm_cli_version=$(helm version --template '{{.Version}}' 2>/dev/null || true)
  helm_semver="${helm_cli_version%%+*}"
  if [[ ! "$helm_semver" =~ $semver_pattern ]] || ! version_is_at_least "$helm_semver" "3.15.0"; then
    add_check "helm_version_unsupported" "blocked"
    return
  fi
  add_check "helm_and_kubectl_available" "pass"

  if [[ -n "$helm_release" ]]; then
    if ! releases=$(helm list --namespace "$helm_namespace" --all -o json 2>/dev/null); then
      add_check "helm_release_lookup_failed" "blocked"
      return
    fi
    release_data=$(jq -c --arg name "$helm_release" '[.[] | select(.name == $name)]' <<<"$releases")
  else
    if ! releases=$(helm list --all-namespaces --all -o json 2>/dev/null); then
      add_check "helm_release_lookup_failed" "blocked"
      return
    fi
    release_data=$(jq -c '[.[] | select(
      ((.chart // "") | startswith("formbricks-")) and
      (((.chart // "") | startswith("formbricks-upgrade-")) | not)
    )]' <<<"$releases")
  fi

  release_count=$(jq -r 'length' <<<"$release_data")
  if [[ "$release_count" != "1" ]]; then
    if [[ "$release_count" == "0" ]]; then
      add_check "helm_release_missing" "blocked"
    else
      add_check "helm_release_ambiguous" "blocked"
    fi
    return
  fi

  helm_release=$(jq -er '.[0].name' <<<"$release_data")
  helm_namespace=$(jq -er '.[0].namespace' <<<"$release_data")
  release_status=$(jq -er '.[0].status // empty' <<<"$release_data" 2>/dev/null || true)
  helm_release_status="$release_status"
  helm_release_revision=$(jq -er '.[0].revision // empty' <<<"$release_data" 2>/dev/null || true)
  if [[ "$release_status" != "deployed" && "$action" != "resume" ]]; then
    add_check "helm_release_not_deployed" "blocked"
    return
  fi
  if [[ "$action" == "resume" ]] &&
    [[ "$release_status" != "deployed" && "$release_status" != "failed" &&
      "$release_status" != "pending-upgrade" && "$release_status" != "pending-rollback" ]]; then
    add_check "helm_release_not_resumable" "blocked"
    return
  fi
  add_check "helm_release_deployed" "pass"

  if ! values=$(helm get values "$helm_release" --namespace "$helm_namespace" -o json 2>/dev/null); then
    add_check "helm_values_unreadable" "blocked"
    return
  fi
  add_check "deployment_config_readable" "pass"
  helm_inspected_values="$values"
  resolved_install_type="helm"

  if ! resolve_helm_database_binding; then
    add_check "${helm_database_binding_error:-helm_database_source_unsupported}" "blocked"
    return
  fi
  if [[ -n "$helm_database_secret" ]]; then
    add_check "helm_database_source_bound" "pass"
  fi

  if ! parse_safe_helm_operator_values; then
    add_check "helm_values_unsafe" "blocked"
    return
  fi
  if [[ -n "$helm_values_path" ]]; then
    add_check "helm_operator_values_valid" "pass"
  fi

  if [[ -n "$current_version_override" ]]; then
    current_version=$(normalize_version "$current_version_override")
  else
    current_version=$(jq -er '.[0].app_version // empty' <<<"$release_data" 2>/dev/null || true)
    current_version=$(normalize_version "$current_version")
  fi

  current_image_digest=$(jq -er '.deployment.image.digest // empty' <<<"$values" 2>/dev/null || true)
  if [[ "$current_image_digest" =~ $digest_pattern ]]; then
    current_image_pinned=true
  else
    current_image_digest=""
    # The first bridge Helm upgrade can fail before a signed bridge revision exists. Recovery then
    # restores the source revision, so its workload image must already be immutable; a moving tag
    # could otherwise resolve to a different authorization mode during rollback.
    add_check "helm_source_image_not_pinned" "blocked"
  fi

  if [[ "$(jq -r 'if .postgresql.enabled == false then "false" else "true" end' <<<"$values")" == "true" ]]; then
    database_mode="bundled"
  else
    database_mode="external"
  fi
  add_check "database_configuration_present" "pass"

  if [[ "$(jq -r '.authzed.enabled // false' <<<"$values")" == "true" ]]; then
    authzed_configured=true
  fi

  # Check every direct Kubernetes operation used by the assistant. Helm's server-side dry-runs below
  # remain the authoritative admission/RBAC check for the complete rendered charts.
  local required_kubernetes_permissions=(
    "get deployments.apps"
    "list deployments.apps"
    "watch deployments.apps"
    "patch deployments.apps"
    "update deployments.apps"
    "get replicasets.apps"
    "list replicasets.apps"
    "watch replicasets.apps"
    "get horizontalpodautoscalers.autoscaling"
    "list horizontalpodautoscalers.autoscaling"
    "watch horizontalpodautoscalers.autoscaling"
    "patch horizontalpodautoscalers.autoscaling"
    "update horizontalpodautoscalers.autoscaling"
    "get pods"
    "list pods"
    "watch pods"
    "get pods/log"
    "create pods/exec"
    "get jobs.batch"
    "list jobs.batch"
    "watch jobs.batch"
    "create jobs.batch"
    "update jobs.batch"
    "patch jobs.batch"
    "delete jobs.batch"
    "get configmaps"
    "list configmaps"
    "watch configmaps"
    "create configmaps"
    "update configmaps"
    "patch configmaps"
    "delete configmaps"
    "get leases.coordination.k8s.io"
    "list leases.coordination.k8s.io"
    "watch leases.coordination.k8s.io"
    "create leases.coordination.k8s.io"
    "update leases.coordination.k8s.io"
    "patch leases.coordination.k8s.io"
    "delete leases.coordination.k8s.io"
    "get secrets"
    "list secrets"
    "watch secrets"
    "create secrets"
    "update secrets"
    "patch secrets"
    "delete secrets"
  )
  local required_permission verb resource permission_result kubernetes_permissions_sufficient=true
  for required_permission in "${required_kubernetes_permissions[@]}"; do
    read -r verb resource <<<"$required_permission"
    permission_result=$(kubectl auth can-i "$verb" "$resource" --namespace "$helm_namespace" 2>/dev/null || true)
    if [[ "$permission_result" != "yes" ]]; then
      kubernetes_permissions_sufficient=false
    fi
  done
  if [[ "$kubernetes_permissions_sufficient" == "true" ]]; then
    add_check "kubernetes_permissions_sufficient" "pass"
  else
    add_check "kubernetes_permissions_insufficient" "blocked"
  fi

  inspect_spicedb_crd_requirement || true
}

case "$install_type" in
  docker) inspect_docker_installation ;;
  helm) inspect_helm_installation ;;
esac

version_state="unknown"
if [[ -z "$current_version" || ! "$current_version" =~ $semver_pattern ]]; then
  add_check "current_version_unknown" "blocked"
elif [[ "$manifest_valid" == "true" ]]; then
  current_major=$(version_core "$current_version")
  current_major="${current_major%%.*}"
  target_major=$(version_core "$release_version")
  target_major="${target_major%%.*}"

  if [[ "$(normalize_version "$current_version")" == "$(normalize_version "$release_version")" ]]; then
    version_state="already_target_release"
    add_check "source_already_target_release" "pass"
  elif jq -e --arg version "$(normalize_version "$current_version")" \
    'index($version) != null' <<<"$supported_pre_activation_versions" >/dev/null 2>&1; then
    version_state="supported_upgrade"
    add_check "source_pre_activation_version_supported" "pass"
  elif [[ "$current_major" == "5" ]] && version_is_at_least "$current_version" "$minimum_source_version"; then
    version_state="supported_upgrade"
    add_check "source_version_supported" "pass"
  elif [[ "$current_major" == "$target_major" ]]; then
    version_state="unsupported"
    add_check "source_target_major_version_unsupported" "blocked"
  else
    version_state="unsupported"
    add_check "source_version_unsupported" "blocked"
  fi
fi

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

hash_text() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    shasum -a 256 | awk '{print $1}'
  fi
}

upgrade_lock_kind=""
upgrade_lock_path=""
upgrade_lock_owner=""
upgrade_lock_heartbeat_pid=""
upgrade_lock_lost_marker=""

local_lock_owner_is_dead() {
  local owner="$1"
  local owner_pid="${owner%%:*}"

  [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null
}

acquire_docker_upgrade_lock() {
  local compose_directory="$1"
  local existing_owner current_owner attempt=1

  upgrade_lock_kind="docker"
  upgrade_lock_path="${compose_directory}/.formbricks-v6-upgrade.lock"
  upgrade_lock_owner="$$:$(date -u +%s):${RANDOM}${RANDOM}"

  while [[ "$attempt" -le 3 ]]; do
    if ln -s "$upgrade_lock_owner" "$upgrade_lock_path" 2>/dev/null; then
      return 0
    fi
    existing_owner=$(readlink "$upgrade_lock_path" 2>/dev/null || true)
    if [[ -z "$existing_owner" ]] || ! local_lock_owner_is_dead "$existing_owner"; then
      return 1
    fi

    # The symlink value is the ownership token. Re-read it immediately before removal so two stale
    # lock reclaimers can race safely; the following ln still admits only one winner.
    current_owner=$(readlink "$upgrade_lock_path" 2>/dev/null || true)
    if [[ "$current_owner" == "$existing_owner" ]]; then
      rm -f "$upgrade_lock_path"
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

helm_lock_holder_is_dead_locally() {
  local holder="$1"
  local holder_host holder_pid
  IFS=: read -r holder_host holder_pid _ <<<"$holder"
  [[ "$holder_host" == "$(hostname | hash_text | cut -c1-12)" && "$holder_pid" =~ ^[0-9]+$ ]] &&
    ! kill -0 "$holder_pid" 2>/dev/null
}

renew_helm_upgrade_lock() {
  local parent_pid="$1"
  local payload now

  while kill -0 "$parent_pid" 2>/dev/null; do
    sleep "${FORMBRICKS_UPGRADE_LOCK_RENEW_SECONDS:-20}"
    kill -0 "$parent_pid" 2>/dev/null || return 0
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    payload=$(jq -cn --arg owner "$upgrade_lock_owner" --arg now "$now" '[
      {op:"test",path:"/spec/holderIdentity",value:$owner},
      {op:"replace",path:"/spec/renewTime",value:$now}
    ]')
    if ! kubectl patch lease "$upgrade_lock_path" --namespace "$helm_namespace" --type=json \
      -p "$payload" >/dev/null 2>&1; then
      : >"$upgrade_lock_lost_marker"
      return 1
    fi
  done
}

acquire_helm_upgrade_lock() {
  local scope_hash now lease existing_holder expires_at replacement attempt=1

  scope_hash=$(printf '%s' "${helm_namespace}/${helm_release}" | hash_text | cut -c1-12)
  upgrade_lock_kind="helm"
  upgrade_lock_path="formbricks-v6-upgrade-${scope_hash}"
  upgrade_lock_owner="$(hostname | hash_text | cut -c1-12):$$:${RANDOM}${RANDOM}"
  upgrade_lock_lost_marker="${TMPDIR:-/tmp}/.${upgrade_lock_path}.${RANDOM}.lost"
  rm -f "$upgrade_lock_lost_marker"

  while [[ "$attempt" -le 5 ]]; do
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    lease=$(jq -cn --arg name "$upgrade_lock_path" --arg namespace "$helm_namespace" \
      --arg owner "$upgrade_lock_owner" --arg now "$now" '{
        apiVersion:"coordination.k8s.io/v1",
        kind:"Lease",
        metadata:{name:$name,namespace:$namespace,labels:{"app.kubernetes.io/managed-by":"formbricks-upgrade-assistant"}},
        spec:{holderIdentity:$owner,leaseDurationSeconds:90,acquireTime:$now,renewTime:$now}
      }')
    if printf '%s\n' "$lease" | kubectl create --namespace "$helm_namespace" -f - \
      >/dev/null 2>&1; then
      renew_helm_upgrade_lock "$$" &
      upgrade_lock_heartbeat_pid=$!
      return 0
    fi

    lease=$(kubectl get lease "$upgrade_lock_path" --namespace "$helm_namespace" -o json \
      2>/dev/null || true)
    [[ -n "$lease" ]] || {
      attempt=$((attempt + 1))
      continue
    }
    existing_holder=$(jq -r '.spec.holderIdentity // empty' <<<"$lease")
    expires_at=$(jq -r '
      try (((.spec.renewTime // .spec.acquireTime) | fromdateiso8601) +
        (.spec.leaseDurationSeconds // 0)) catch 0
    ' <<<"$lease")
    if [[ -n "$existing_holder" ]] && ! helm_lock_holder_is_dead_locally "$existing_holder" &&
      [[ "$expires_at" -gt "$(date -u +%s)" ]]; then
      return 1
    fi

    replacement=$(jq --arg owner "$upgrade_lock_owner" --arg now "$now" '
      .spec.holderIdentity=$owner |
      .spec.leaseDurationSeconds=90 |
      .spec.acquireTime=$now |
      .spec.renewTime=$now
    ' <<<"$lease")
    if printf '%s\n' "$replacement" | kubectl replace --namespace "$helm_namespace" -f - \
      >/dev/null 2>&1; then
      renew_helm_upgrade_lock "$$" &
      upgrade_lock_heartbeat_pid=$!
      return 0
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

assert_upgrade_lock_held() {
  local current_owner expires_at lease
  case "$upgrade_lock_kind" in
    docker)
      current_owner=$(readlink "$upgrade_lock_path" 2>/dev/null || true)
      [[ "$current_owner" == "$upgrade_lock_owner" ]]
      ;;
    helm)
      if [[ -e "$upgrade_lock_lost_marker" || -z "$upgrade_lock_heartbeat_pid" ]] ||
        ! kill -0 "$upgrade_lock_heartbeat_pid" 2>/dev/null; then
        return 1
      fi
      if ! lease=$(kubectl get lease "$upgrade_lock_path" --namespace "$helm_namespace" -o json \
        2>/dev/null); then
        : >"$upgrade_lock_lost_marker"
        return 1
      fi
      current_owner=$(jq -r '.spec.holderIdentity // empty' <<<"$lease")
      expires_at=$(jq -r '
        try (((.spec.renewTime // .spec.acquireTime) | fromdateiso8601) +
          (.spec.leaseDurationSeconds // 0)) catch 0
      ' <<<"$lease")
      if [[ "$current_owner" != "$upgrade_lock_owner" || "$expires_at" -le "$(date -u +%s)" ]]; then
        : >"$upgrade_lock_lost_marker"
        return 1
      fi
      ;;
    *) return 1 ;;
  esac
}

release_upgrade_lock() {
  local current_owner payload now

  if [[ -n "$upgrade_lock_heartbeat_pid" ]]; then
    kill "$upgrade_lock_heartbeat_pid" 2>/dev/null || true
    wait "$upgrade_lock_heartbeat_pid" 2>/dev/null || true
    upgrade_lock_heartbeat_pid=""
  fi

  if [[ "$upgrade_lock_kind" == "docker" ]]; then
    current_owner=$(readlink "$upgrade_lock_path" 2>/dev/null || true)
    if [[ "$current_owner" == "$upgrade_lock_owner" ]]; then
      rm -f "$upgrade_lock_path"
    fi
  elif [[ "$upgrade_lock_kind" == "helm" && -n "$upgrade_lock_path" ]]; then
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    payload=$(jq -cn --arg owner "$upgrade_lock_owner" --arg now "$now" '[
      {op:"test",path:"/spec/holderIdentity",value:$owner},
      {op:"replace",path:"/spec/holderIdentity",value:""},
      {op:"replace",path:"/spec/leaseDurationSeconds",value:0},
      {op:"replace",path:"/spec/renewTime",value:$now}
    ]')
    kubectl patch lease "$upgrade_lock_path" --namespace "$helm_namespace" --type=json \
      -p "$payload" >/dev/null 2>&1 || true
  fi
  [[ -z "$upgrade_lock_lost_marker" ]] || rm -f "$upgrade_lock_lost_marker"
  upgrade_lock_kind=""
}

verify_signed_artifact() {
  local path="$1"
  local expected_digest="$2"

  [[ -f "$path" ]] || return 1
  [[ "sha256:$(hash_file "$path")" == "$expected_digest" ]]
}

install_signed_artifact() {
  local source_path="$1"
  local destination_path="$2"
  local expected_digest="$3"
  local mode="$4"

  verify_signed_artifact "$source_path" "$expected_digest" || return 1
  if [[ -e "$destination_path" ]]; then
    verify_signed_artifact "$destination_path" "$expected_digest" || return 1
  else
    cp "$source_path" "$destination_path"
  fi
  chmod "$mode" "$destination_path"
}

serialize_dotenv_value() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\$\$}
  printf '"%s"' "$value"
}

upsert_dotenv_value() {
  local env_path="$1"
  local key="$2"
  local value="$3"
  local temporary

  temporary=$(mktemp "${env_path}.tmp.XXXXXX")
  awk -v key="$key" -v value="$value" '
    BEGIN { written = 0 }
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*=" {
      if (!written) print key "=" value
      written = 1
      next
    }
    { print }
    END { if (!written) print key "=" value }
  ' "$env_path" >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$env_path"
}

dotenv_has_nonempty_value() {
  local env_path="$1"
  local key="$2"
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*=" {
      value = $0
      sub("^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*=[[:space:]]*", "", value)
      gsub("^[[:space:]]+|[[:space:]]+$", "", value)
      if (value != "" && value != "\"\"" && value != "\047\047") found = 1
    }
    END { exit(found ? 0 : 1) }
  ' "$env_path"
}

ensure_generated_secret() {
  local env_path="$1"
  local key="$2"
  if ! dotenv_has_nonempty_value "$env_path" "$key"; then
    upsert_dotenv_value "$env_path" "$key" "$(openssl rand -hex 32)"
  fi
}

docker_compose_directory=""
docker_compose_file=""
docker_env_file=""
docker_installed_overlay=""
docker_upgrade_log=""
docker_upgrade_state=""

run_upgrade_compose() {
  assert_upgrade_lock_held || return 1
  AUTHZED_POSTGRES_BOOTSTRAP_IMAGE_REF="$postgres_bootstrap_image" \
    SPICEDB_IMAGE_REF="$spicedb_image" \
    run_docker compose \
    --project-directory "$docker_compose_directory" \
    --env-file "$docker_env_file" \
    -f "$docker_compose_file" \
    -f "$docker_installed_overlay" \
    "$@"
}

run_logged_upgrade_compose() {
  run_upgrade_compose "$@" >>"$docker_upgrade_log" 2>&1
}

write_upgrade_state() {
  local state="$1"
  local receipt="${2:-}"
  local temporary
  temporary=$(mktemp "${docker_upgrade_state}.tmp.XXXXXX")
  jq -cn \
    --arg state "$state" \
    --arg receipt "$receipt" \
    --arg bridgeImage "$bridge_image" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetImage "$target_image" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    '{
      state: $state,
      receipt: (if $receipt == "" then null else $receipt end),
      bridgeImage: $bridgeImage,
      bridgeManifestDigest: $bridgeManifestDigest,
      targetImage: $targetImage,
      targetManifestDigest: $targetManifestDigest
    }' \
    >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$docker_upgrade_state"
}

read_upgrade_state() {
  if [[ ! -f "$docker_upgrade_state" ]]; then
    printf '%s' '{}'
    return
  fi
  jq -cer \
    --arg bridgeImage "$bridge_image" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetImage "$target_image" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    'select(
      type == "object" and
      (.state | IN(
        "initialized",
        "activated",
        "bridge_ready",
        "bridge_restored",
        "finalized",
        "manual_recovery_required",
        "prepared",
        "rollback_failed",
        "rolled_back"
      )) and
      .bridgeImage == $bridgeImage and
      .bridgeManifestDigest == $bridgeManifestDigest and
      .targetImage == $targetImage and
      .targetManifestDigest == $targetManifestDigest and
      ((.receipt == null) or (.receipt | type == "string"))
    )' "$docker_upgrade_state" 2>/dev/null
}

emit_upgrade_success() {
  jq -cn --arg releaseVersion "$release_version" \
    '{schemaVersion: 1, status: "upgraded", mutating: true, releaseVersion: $releaseVersion}'
}

set_active_formbricks_image() {
  assert_upgrade_lock_held || return 1
  upsert_dotenv_value "$docker_env_file" "FORMBRICKS_IMAGE_REF" "$1"
}

run_activation_command() {
  run_upgrade_compose --profile authzed-ops run --rm -T authzed-ops activation "$@" \
    2>>"$docker_upgrade_log"
}

wait_for_runtime_check() {
  local expected_authority="$1"
  local attempt=1
  local result

  while [[ "$attempt" -le 30 ]]; do
    result=$(run_upgrade_compose exec -T formbricks formbricks-authzed activation runtime-check \
      2>>"$docker_upgrade_log" || true)
    if jq -e --arg authority "$expected_authority" \
      '.status == "ready" and .authority == $authority' <<<"$result" >/dev/null 2>&1; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_docker_application_health() {
  local attempt=1

  while [[ "$attempt" -le 30 ]]; do
    if run_upgrade_compose exec -T formbricks node -e '
      const port = process.env.PORT || "3000";
      fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(5000) })
        .then((response) => process.exit(response.ok ? 0 : 1))
        .catch(() => process.exit(1));
    ' >>"$docker_upgrade_log" 2>&1; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

resume_interrupted_docker_activation() {
  local receipt="$1"
  local attempt=1
  local max_attempts="${FORMBRICKS_UPGRADE_ACTIVATION_RESUME_ATTEMPTS:-480}"
  local status_output authority transition fence_active

  while [[ "$attempt" -le "$max_attempts" ]]; do
    status_output=$(run_activation_command status 2>/dev/null || true)
    authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
    transition=$(jq -r '.transition // empty' <<<"$status_output" 2>/dev/null || true)
    fence_active=$(jq -r '.fenceActive // false' <<<"$status_output" 2>/dev/null || true)

    if [[ "$authority" == "spicedb" ]]; then
      return 0
    fi
    if [[ "$authority" != "legacy" ||
      ("$transition" != "activating" && "$transition" != "prepared") ]]; then
      return 1
    fi
    if [[ "$transition" == "prepared" || "$fence_active" != "true" ]]; then
      if run_activation_command activate --receipt "$receipt" >/dev/null; then
        return 0
      fi
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

complete_docker_candidate_activation() {
  local receipt="$1"

  write_upgrade_state "activated" "$receipt"
  set_active_formbricks_image "$target_image"
  if ! run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks ||
    ! wait_for_runtime_check spicedb ||
    ! wait_for_docker_application_health ||
    ! run_activation_command finalize --receipt "$receipt" >/dev/null; then
    if rollback_after_activation "$receipt"; then
      emit_bootstrap_error "candidate_failed_rolled_back"
    else
      emit_bootstrap_error "candidate_failed_rollback_incomplete"
    fi
    return 1
  fi

  write_upgrade_state "finalized" "$receipt"
  emit_upgrade_success
}

restore_bridge_before_activation() {
  local receipt="${1:-}"
  set_active_formbricks_image "$bridge_image"
  if run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks &&
    wait_for_runtime_check legacy && wait_for_docker_application_health; then
    write_upgrade_state "bridge_restored" "$receipt"
    return 0
  fi

  write_upgrade_state "manual_recovery_required" "$receipt"
  return 1
}

rollback_after_activation() {
  local receipt="$1"

  printf '%s\n' "↩️ Candidate verification failed; restoring the signed bridge." >&2
  run_logged_upgrade_compose stop --timeout 60 formbricks || true
  set_active_formbricks_image "$target_image"
  if ! run_activation_command rollback-begin --receipt "$receipt" >/dev/null; then
    write_upgrade_state "rollback_failed" "$receipt"
    return 1
  fi

  set_active_formbricks_image "$bridge_image"
  if ! run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks; then
    write_upgrade_state "rollback_failed" "$receipt"
    return 1
  fi
  if ! wait_for_runtime_check legacy; then
    write_upgrade_state "rollback_failed" "$receipt"
    return 1
  fi
  # The database authority must remain fenced until the bridge is not only running the expected
  # authorization mode but also serving the application health contract.
  if ! wait_for_docker_application_health; then
    write_upgrade_state "rollback_failed" "$receipt"
    return 1
  fi
  if ! run_activation_command rollback-complete --receipt "$receipt" >/dev/null; then
    write_upgrade_state "rollback_failed" "$receipt"
    return 1
  fi

  write_upgrade_state "rolled_back" "$receipt"
  return 0
}

execute_docker_upgrade() {
  local rendered_base rendered_authzed postgres_password postgres_password_encoded prepare_output receipt
  local status_output authority transition existing_state state_name state_receipt formbricks_database_url
  local authzed_database_password authzed_database_password_encoded without_escaped_dollars

  if [[ "$resolved_install_type" != "one_click" && "$resolved_install_type" != "docker_compose" ]]; then
    emit_bootstrap_error "docker_upgrade_required"
    return 2
  fi

  docker_compose_directory=$(cd -- "$(dirname -- "$compose_file")" && pwd)
  docker_compose_file="${docker_compose_directory}/$(basename -- "$compose_file")"
  docker_env_file="${docker_compose_directory}/.env"
  docker_installed_overlay="${docker_compose_directory}/${DEFAULT_DOCKER_OVERLAY_NAME}"
  docker_upgrade_log="${docker_compose_directory}/formbricks-v6-upgrade.log"
  docker_upgrade_state="${docker_compose_directory}/.formbricks-v6-upgrade-state.json"

  # The bridge and candidate are both built from the v6 release, so an interrupted run can report
  # the target major even though activation is incomplete. Consult the signed-pair-bound journal
  # before treating a v6 runtime as an ordinary, already-upgraded installation.
  existing_state=$(read_upgrade_state || true)
  if [[ -z "$existing_state" ]]; then
    emit_bootstrap_error "upgrade_state_invalid"
    return 2
  fi
  state_name=$(jq -er '.state // empty' <<<"$existing_state" 2>/dev/null || true)
  state_receipt=$(jq -er '.receipt // empty' <<<"$existing_state" 2>/dev/null || true)
  if [[ "$version_state" == "already_target_release" && -z "$state_name" ]]; then
    printf '%s\n' "$preflight_result"
    return 0
  fi

  if [[ "$database_mode" != "bundled" ]]; then
    emit_bootstrap_error "docker_external_database_not_supported"
    return 2
  fi
  if [[ "$confirmed" != "true" || "$backup_confirmed" != "true" ]]; then
    emit_bootstrap_error "docker_confirmation_required"
    return 2
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    emit_bootstrap_error "openssl_missing"
    return 2
  fi

  umask 077
  # Persist the signed bridge/candidate pair before touching the installation. A process that dies
  # during the first bridge deployment can then resume even though that v6 bridge reports major 6.
  if [[ ! -e "$docker_upgrade_state" ]]; then
    if ! write_upgrade_state "initialized"; then
      emit_bootstrap_error "upgrade_state_initialize_failed"
      return 2
    fi
  fi

  # Bind any interrupted-run state to this signed bridge/target pair before changing configuration.
  # Only a missing state file is treated as a new run.
  existing_state=$(read_upgrade_state || true)
  if [[ -z "$existing_state" ]]; then
    emit_bootstrap_error "upgrade_state_invalid"
    return 2
  fi
  state_name=$(jq -er '.state // empty' <<<"$existing_state" 2>/dev/null || true)
  state_receipt=$(jq -er '.receipt // empty' <<<"$existing_state" 2>/dev/null || true)
  touch "$docker_env_file" "$docker_upgrade_log"
  chmod 600 "$docker_env_file" "$docker_upgrade_log"
  if [[ ! -e "${docker_env_file}.before-v6-authzed" ]]; then
    cp -p "$docker_env_file" "${docker_env_file}.before-v6-authzed"
    chmod 600 "${docker_env_file}.before-v6-authzed"
  fi

  if ! install_signed_artifact "$docker_overlay_path" "$docker_installed_overlay" "$docker_overlay_digest" 644 ||
    ! install_signed_artifact "$postgres_bootstrap_path" \
      "${docker_compose_directory}/${DEFAULT_POSTGRES_BOOTSTRAP_NAME}" "$postgres_bootstrap_digest" 700; then
    emit_bootstrap_error "signed_docker_artifact_invalid"
    return 2
  fi

  if ! rendered_base=$(run_docker compose --project-directory "$docker_compose_directory" \
    -f "$docker_compose_file" config --format json 2>>"$docker_upgrade_log"); then
    emit_bootstrap_error "compose_config_invalid"
    return 2
  fi
  if ! formbricks_database_url=$(jq -er '
      select(.services.postgres | type == "object")
      | select((.services.postgres.environment.POSTGRES_USER // "postgres") == "postgres")
      | .services.formbricks.environment.DATABASE_URL
      | select(
          type == "string" and
          length > 0 and
          ((contains("\n") or contains("\r")) | not) and
          test("^postgres(ql)?://[^/]+@postgres(:5432)?/")
        )
    ' <<<"$rendered_base" 2>/dev/null); then
    emit_bootstrap_error "docker_external_database_not_supported"
    return 2
  fi
  postgres_password=$(jq -er '
      .services.postgres.environment.POSTGRES_PASSWORD
      | select(type == "string" and length > 0)
      | select((contains("\n") or contains("\r")) | not)
    ' <<<"$rendered_base" 2>/dev/null || true)
  if [[ -z "$postgres_password" ]]; then
    emit_bootstrap_error "bundled_postgres_password_unavailable"
    return 2
  fi
  without_escaped_dollars=${postgres_password//\$\$/}
  if [[ "$without_escaped_dollars" == *\$* ]]; then
    emit_bootstrap_error "bundled_postgres_password_unavailable"
    return 2
  fi
  postgres_password=${postgres_password//\$\$/\$}
  postgres_password_encoded=$(jq -rn --arg value "$postgres_password" '$value | @uri')

  if ! dotenv_has_nonempty_value "$docker_env_file" "POSTGRES_PASSWORD"; then
    upsert_dotenv_value "$docker_env_file" "POSTGRES_PASSWORD" "$(serialize_dotenv_value "$postgres_password")"
  fi
  upsert_dotenv_value "$docker_env_file" "POSTGRES_PASSWORD_URL_ENCODED" "$postgres_password_encoded"
  # Preserve the exact already-rendered application connection contract. Customer-owned Compose
  # files may use a non-default application database user, database, or query parameters even when
  # the supported bundled PostgreSQL service retains its default internal listener and admin role.
  upsert_dotenv_value \
    "$docker_env_file" \
    "FORMBRICKS_AUTHZED_DATABASE_URL" \
    "$(serialize_dotenv_value "$formbricks_database_url")"
  ensure_generated_secret "$docker_env_file" "AUTHZED_TOKEN"
  ensure_generated_secret "$docker_env_file" "AUTHZED_DATABASE_PASSWORD"
  # Compose needs the URL-encoded form only for the SpiceDB connection URI. Resolve the raw value
  # through Compose itself so quoted or dollar-containing customer values are preserved without
  # sourcing the dotenv file, and never write the raw value to stdout or the upgrade log.
  upsert_dotenv_value "$docker_env_file" "AUTHZED_DATABASE_PASSWORD_URL_ENCODED" "pending"
  if ! rendered_authzed=$(run_upgrade_compose config --format json 2>>"$docker_upgrade_log"); then
    emit_bootstrap_error "authzed_overlay_config_invalid"
    return 2
  fi
  authzed_database_password=$(jq -er '
      .services["authzed-db-bootstrap"].environment.AUTHZED_DATABASE_PASSWORD
      | select(type == "string" and length > 0)
      | select((contains("\n") or contains("\r")) | not)
    ' <<<"$rendered_authzed" 2>/dev/null || true)
  without_escaped_dollars=${authzed_database_password//\$\$/}
  if [[ -z "$authzed_database_password" || "$without_escaped_dollars" == *\$* ]]; then
    emit_bootstrap_error "authzed_database_password_unavailable"
    return 2
  fi
  authzed_database_password=${authzed_database_password//\$\$/\$}
  authzed_database_password_encoded=$(jq -rn --arg value "$authzed_database_password" '$value | @uri')
  upsert_dotenv_value \
    "$docker_env_file" \
    "AUTHZED_DATABASE_PASSWORD_URL_ENCODED" \
    "$authzed_database_password_encoded"
  upsert_dotenv_value "$docker_env_file" "AUTHZED_ENABLED" "true"
  upsert_dotenv_value "$docker_env_file" "AUTHZED_ENDPOINT" "spicedb:50051"
  upsert_dotenv_value "$docker_env_file" "AUTHZED_SYSTEM_KEY" "formbricks"
  upsert_dotenv_value "$docker_env_file" "AUTHZED_INSECURE" "true"
  upsert_dotenv_value "$docker_env_file" "AUTHZED_CONSISTENCY" "fully_consistent"
  upsert_dotenv_value "$docker_env_file" "AUTHZED_POSTGRES_BOOTSTRAP_IMAGE_REF" "$postgres_bootstrap_image"
  upsert_dotenv_value "$docker_env_file" "SPICEDB_IMAGE_REF" "$spicedb_image"
  upsert_dotenv_value "$docker_env_file" "FORMBRICKS_AUTHZED_BRIDGE_IMAGE_REF" "$bridge_image"
  upsert_dotenv_value "$docker_env_file" "FORMBRICKS_AUTHZED_TARGET_IMAGE_REF" "$target_image"
  case "$state_name" in
    activated|finalized|manual_recovery_required|rollback_failed)
      set_active_formbricks_image "$target_image"
      ;;
    *)
      set_active_formbricks_image "$bridge_image"
      ;;
  esac

  if ! run_upgrade_compose config >/dev/null 2>>"$docker_upgrade_log"; then
    emit_bootstrap_error "authzed_overlay_config_invalid"
    return 2
  fi

  printf '%s\n' "🔐 Preparing the signed legacy-authoritative bridge and private SpiceDB runtime." >&2
  if ! run_logged_upgrade_compose pull formbricks authzed-ops spicedb-migrate spicedb ||
    ! run_docker pull "$target_image" >>"$docker_upgrade_log" 2>&1 ||
    ! run_logged_upgrade_compose up -d postgres authzed-db-bootstrap spicedb-migrate spicedb ||
    ! run_logged_upgrade_compose run --rm -T --no-deps --entrypoint node formbricks \
      packages/database/dist/scripts/apply-migrations.js; then
    restore_bridge_before_activation || true
    emit_bootstrap_error "bridge_deployment_failed"
    return 1
  fi

  status_output=$(run_activation_command status 2>/dev/null || true)
  authority=$(jq -er 'select(.status == "ready") | .authority' <<<"$status_output" 2>/dev/null || true)
  transition=$(jq -er 'select(.status == "ready") | .transition' <<<"$status_output" 2>/dev/null || true)
  if [[ -z "$authority" || -z "$transition" ]]; then
    emit_bootstrap_error "activation_status_failed"
    return 1
  fi

  if [[ "$authority" == "spicedb" ]]; then
    if [[ "$state_name" == "finalized" ]]; then
      set_active_formbricks_image "$target_image"
      if run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks &&
        wait_for_runtime_check spicedb && wait_for_docker_application_health; then
        emit_upgrade_success
        return 0
      fi
    fi
    if [[ "$state_name" == "activated" && "$transition" == "idle" && -n "$state_receipt" ]]; then
      # Finalization can commit before its response or journal write reaches the assistant. Re-verify
      # the exact candidate and call finalize with the same receipt; the activation protocol treats
      # that exact already-finalized receipt as success.
      set_active_formbricks_image "$target_image"
      if run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks &&
        wait_for_runtime_check spicedb && wait_for_docker_application_health &&
        run_activation_command finalize --receipt "$state_receipt" >/dev/null; then
        write_upgrade_state "finalized" "$state_receipt"
        emit_upgrade_success
        return 0
      fi
    fi
    if [[ -n "$state_receipt" ]] && rollback_after_activation "$state_receipt"; then
      emit_bootstrap_error "interrupted_upgrade_rolled_back"
      return 1
    fi
    set_active_formbricks_image "$target_image"
    run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks || true
    write_upgrade_state "manual_recovery_required" "$state_receipt"
    emit_bootstrap_error "activation_state_requires_manual_recovery"
    return 1
  fi

  if [[ "$authority" != "legacy" ]]; then
    emit_bootstrap_error "activation_state_requires_manual_recovery"
    return 1
  fi
  if [[ "$transition" == "activating" ]]; then
    if [[ -z "$state_receipt" ||
      ("$state_name" != "prepared" && "$state_name" != "bridge_restored") ]]; then
      emit_bootstrap_error "activation_state_requires_manual_recovery"
      return 1
    fi

    # A previous client may have died after the database fence committed but before authority changed.
    # Keep the application quiesced, wait for that bounded fence to expire, and re-run the idempotent
    # activation with the exact signed receipt. This is the only safe forward path before authority flips.
    if ! run_logged_upgrade_compose stop --timeout 60 formbricks ||
      ! resume_interrupted_docker_activation "$state_receipt"; then
      write_upgrade_state "prepared" "$state_receipt"
      emit_bootstrap_error "activation_resume_pending"
      return 1
    fi
    complete_docker_candidate_activation "$state_receipt"
    return $?
  elif [[ "$transition" == "prepared" ]]; then
    if [[ -n "$state_receipt" ]]; then
      if ! run_activation_command abort --receipt "$state_receipt" >/dev/null; then
        emit_bootstrap_error "activation_state_requires_manual_recovery"
        return 1
      fi
      write_upgrade_state "bridge_restored"
    elif [[ "$state_name" != "initialized" && "$state_name" != "bridge_ready" ]]; then
      emit_bootstrap_error "activation_state_requires_manual_recovery"
      return 1
    fi
    # With no journaled receipt, prepare may have committed immediately before the process died.
    # Repeating the same signed immutable plan returns that receipt; the normal prepare step below
    # persists it before quiescing the workload.
  elif [[ "$transition" != "idle" && "$transition" != "preparing" ]]; then
    emit_bootstrap_error "activation_state_requires_manual_recovery"
    return 1
  fi

  printf '%s\n' "🔐 Starting the signed legacy-authoritative bridge." >&2
  if ! run_logged_upgrade_compose up -d --no-deps --force-recreate formbricks ||
    ! wait_for_runtime_check legacy || ! wait_for_docker_application_health; then
    restore_bridge_before_activation || true
    emit_bootstrap_error "bridge_deployment_failed"
    return 1
  fi
  write_upgrade_state "bridge_ready"

  prepare_output=$(run_activation_command prepare \
    --bridge-image-digest "$bridge_digest" \
    --bridge-manifest-digest "$bridge_runtime_manifest_digest" \
    --candidate-image-digest "$target_digest" \
    --candidate-manifest-digest "$target_runtime_manifest_digest" || true)
  receipt=$(jq -er 'select(.status == "prepared") | .receipt' <<<"$prepare_output" 2>/dev/null || true)
  if [[ -z "$receipt" ]]; then
    write_upgrade_state "bridge_ready"
    emit_bootstrap_error "activation_prepare_failed"
    return 1
  fi
  write_upgrade_state "prepared" "$receipt"

  printf '%s\n' "⏸️ Quiescing Formbricks while the final graph is fenced and activated." >&2
  if ! run_logged_upgrade_compose stop --timeout 60 formbricks; then
    restore_bridge_before_activation "$receipt" || true
    emit_bootstrap_error "workload_quiesce_failed"
    return 1
  fi

  if ! run_activation_command activate --receipt "$receipt" >/dev/null; then
    status_output=$(run_activation_command status 2>/dev/null || true)
    authority=$(jq -er '.authority // empty' <<<"$status_output" 2>/dev/null || true)
    if [[ "$authority" == "spicedb" ]]; then
      rollback_after_activation "$receipt" || true
    else
      restore_bridge_before_activation "$receipt" || true
    fi
    emit_bootstrap_error "activation_failed"
    return 1
  fi
  complete_docker_candidate_activation "$receipt"
}

helm_upgrade_log=""
helm_work_directory=""
helm_original_values_file=""
helm_operator_values_file=""
helm_retired_values_file=""
helm_phase_values_file=""
helm_upgrade_release=""
helm_generation=""
