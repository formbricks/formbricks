kubectl_logged() {
  kubectl "$@" >>"$helm_upgrade_log" 2>&1
}

initialize_helm_journal() {
  local deployments deployment_count deployment replicas hpa hpa_enabled=false hpa_min=1 hpa_max=1
  local gitops_detected=false revision operator_values_content="" generation release_hash original_image
  local checksums_digest main_chart_digest upgrade_chart_digest temporary

  helm_deployment_component=$(jq -r '
    (.componentOverride // empty | select(length > 0)) //
    (.nameOverride // empty | select(length > 0)) //
    "formbricks"
  ' <<<"$helm_inspected_values")
  helm_deployment_component="${helm_deployment_component:0:63}"
  helm_deployment_component="${helm_deployment_component%-}"
  helm_selector="app.kubernetes.io/instance=${helm_release},app.kubernetes.io/component=${helm_deployment_component}"

  deployments=$(kubectl_capture get deployments --namespace "$helm_namespace" -l "$helm_selector" -o json) || return 1
  deployment_count=$(jq -r '.items | length' <<<"$deployments")
  [[ "$deployment_count" == "1" ]] || return 1
  deployment=$(jq -c '.items[0]' <<<"$deployments")
  helm_deployment_name=$(jq -er '.metadata.name' <<<"$deployment") || return 1
  original_image=$(jq -er --arg container "$helm_deployment_name" '
    [.spec.template.spec.containers[] | select(.name == $container)] |
    select(length == 1) | .[0].image
  ' <<<"$deployment") || return 1
  replicas=$(jq -er '.spec.replicas // 1' <<<"$deployment") || return 1

  if jq -e '
      ((.metadata.annotations // {}) | keys | any(test("^(argocd\\.argoproj\\.io|fluxcd\\.io|kustomize\\.toolkit\\.fluxcd\\.io)/"))) or
      ((.metadata.labels // {})["app.kubernetes.io/managed-by"] | strings | test("^(ArgoCD|argocd|Flux|flux)$")) or
      ((.metadata.managedFields // []) | any(.manager | strings | test("argocd|flux"; "i")))
    ' <<<"$deployment" >/dev/null 2>&1; then
    gitops_detected=true
  fi
  if [[ "$gitops_detected" == "true" && "$gitops_paused" != "true" ]]; then
    return 3
  fi

  if hpa=$(kubectl_capture get horizontalpodautoscaler "$helm_deployment_name" \
    --namespace "$helm_namespace" -o json); then
    hpa_enabled=true
    hpa_min=$(jq -er '.spec.minReplicas // 1' <<<"$hpa") || return 1
    hpa_max=$(jq -er '.spec.maxReplicas' <<<"$hpa") || return 1
  fi

  if [[ -n "$helm_values_path" ]]; then
    [[ -f "$helm_values_path" ]] || return 1
    operator_values_content=$(<"$helm_values_path")
  fi

  revision="$helm_release_revision"
  if [[ -z "$revision" ]]; then
    revision=$(helm_capture status "$helm_release" --namespace "$helm_namespace" -o json |
      jq -er '.version') || return 1
  fi

  generation=$(date +%s)
  release_hash=$(printf '%s' "${helm_namespace}/${helm_release}" | hash_text | cut -c1-8)
  helm_upgrade_release="${helm_release:0:40}-${release_hash}-v6-upgrade"
  checksums_digest="sha256:$(hash_file "$checksums_path")"
  main_chart_digest="sha256:$(hash_file "$formbricks_chart_path")"
  upgrade_chart_digest="sha256:$(hash_file "$upgrade_chart_path")"

  temporary=$(mktemp "${helm_state_path}.tmp.XXXXXX")
  jq -cn \
    --arg release "$helm_release" \
    --arg namespace "$helm_namespace" \
    --arg revision "$revision" \
    --arg manifestDigest "sha256:${manifest_digest}" \
    --arg checksumsDigest "$checksums_digest" \
    --arg bridgeImage "$bridge_image" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetImage "$target_image" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    --arg mainChart "$formbricks_chart" \
    --arg mainChartDigest "$main_chart_digest" \
    --arg upgradeChart "$upgrade_chart" \
    --arg upgradeChartDigest "$upgrade_chart_digest" \
    --argjson originalValues "$helm_inspected_values" \
    --arg operatorValues "$operator_values_content" \
    --arg deploymentName "$helm_deployment_name" \
    --arg component "$helm_deployment_component" \
    --arg originalImage "$original_image" \
    --argjson replicas "$replicas" \
    --argjson hpaEnabled "$hpa_enabled" \
    --argjson hpaMin "$hpa_min" \
    --argjson hpaMax "$hpa_max" \
    --arg generation "$generation" \
    --arg upgradeRelease "$helm_upgrade_release" \
    '{
      schemaVersion: 1,
      state: "initialized",
      receipt: null,
      pendingPhase: null,
      pendingExecution: 0,
      execution: 0,
      release: { name: $release, namespace: $namespace, revision: $revision },
      signed: {
        manifestDigest: $manifestDigest,
        checksumsDigest: $checksumsDigest,
        bridgeImage: $bridgeImage,
        bridgeManifestDigest: $bridgeManifestDigest,
        targetImage: $targetImage,
        targetManifestDigest: $targetManifestDigest,
        mainChart: { name: $mainChart, digest: $mainChartDigest },
        upgradeChart: { name: $upgradeChart, digest: $upgradeChartDigest }
      },
      originalValues: $originalValues,
      operatorValues: $operatorValues,
      workload: {
        deploymentName: $deploymentName,
        component: $component,
        originalImage: $originalImage,
        replicas: $replicas,
        hpa: { enabled: $hpaEnabled, minReplicas: $hpaMin, maxReplicas: $hpaMax }
      },
      generation: $generation,
      upgradeRelease: $upgradeRelease
    }' >"$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$helm_state_path"
}

load_helm_journal_files() {
  local journal="$1"

  helm_deployment_name=$(jq -er '.workload.deploymentName' <<<"$journal")
  helm_deployment_component=$(jq -er '.workload.component' <<<"$journal")
  helm_selector="app.kubernetes.io/instance=${helm_release},app.kubernetes.io/component=${helm_deployment_component}"
  helm_generation=$(jq -er '.generation' <<<"$journal")
  helm_upgrade_release=$(jq -er '.upgradeRelease' <<<"$journal")

  helm_work_directory=$(mktemp -d "${TMPDIR:-/tmp}/formbricks-v6-helm.XXXXXX")
  chmod 700 "$helm_work_directory"
  helm_original_values_file="${helm_work_directory}/original-values.json"
  helm_operator_values_file="${helm_work_directory}/operator-values.yaml"
  helm_retired_values_file="${helm_work_directory}/retired-values.json"
  helm_phase_values_file="${helm_work_directory}/phase-values.json"
  jq '.originalValues' <<<"$journal" >"$helm_original_values_file"
  jq -r '.operatorValues' <<<"$journal" >"$helm_operator_values_file"
  jq -cn '{
    migration: { enabled: null },
    authzed: { migrationAcknowledged: null, initialization: null }
  }' >"$helm_retired_values_file"
  chmod 600 "$helm_original_values_file" "$helm_operator_values_file" "$helm_retired_values_file"
}

write_main_phase_values() {
  local image="$1"
  local migration_mode="$2"
  local replicas="$3"
  local hpa_enabled="$4"
  local gate_enabled="$5"
  local repository digest hpa_min hpa_max

  repository="${image%@*}"
  digest="${image##*@}"
  hpa_min=$(jq -er '.workload.hpa.minReplicas' "$helm_state_path")
  hpa_max=$(jq -er '.workload.hpa.maxReplicas' "$helm_state_path")
  jq -cn \
    --arg repository "$repository" \
    --arg digest "$digest" \
    --arg migrationMode "$migration_mode" \
    --argjson replicas "$replicas" \
    --argjson hpaEnabled "$hpa_enabled" \
    --argjson hpaMin "$hpa_min" \
    --argjson hpaMax "$hpa_max" \
    --argjson gateEnabled "$gate_enabled" \
    '{
      deployment: {
        image: { repository: $repository, digest: $digest, tag: null },
        replicas: $replicas
      },
      autoscaling: { enabled: $hpaEnabled, minReplicas: $hpaMin, maxReplicas: $hpaMax },
      migration: (if $migrationMode == "" then {} else { mode: $migrationMode } end),
      authzed: {
        enabled: true,
        consistency: "fully_consistent",
        activation: {
          installBootstrap: { enabled: false, retryOnUpgrade: false },
          upgradeGate: { enabled: $gateEnabled }
        }
      }
    }' >"$helm_phase_values_file"
  chmod 600 "$helm_phase_values_file"
}

run_main_chart_upgrade() {
  local phase="$1"

  # Render against the live cluster so chart lookups can retain generated credentials from the
  # existing release. A client-only `helm template` cannot see those Secrets and rejects the default
  # bundled-PostgreSQL upgrade as if its passwords were missing. Suppress rendered output and hide
  # Secret manifests so the validation log cannot capture credentials.
  if ! helm_render_logged upgrade "$helm_release" "$formbricks_chart_path" \
    --namespace "$helm_namespace" \
    --reset-values \
    --values "$helm_original_values_file" \
    --values "$helm_operator_values_file" \
    --values "$helm_retired_values_file" \
    --values "$helm_phase_values_file" \
    --dry-run=server --hide-secret; then
    return 1
  fi

  printf '%s\n' "🔐 Applying the signed Helm ${phase} revision." >&2
  helm_logged upgrade "$helm_release" "$formbricks_chart_path" \
    --namespace "$helm_namespace" \
    --reset-values \
    --values "$helm_original_values_file" \
    --values "$helm_operator_values_file" \
    --values "$helm_retired_values_file" \
    --values "$helm_phase_values_file" \
    --wait --wait-for-jobs --timeout 45m
}

wait_for_zero_formbricks_pods() {
  local attempt=1 pods
  while [[ "$attempt" -le 120 ]]; do
    pods=$(kubectl_capture get pods --namespace "$helm_namespace" -l "$helm_selector" -o json) || return 1
    if jq -e '[.items[] | select(.metadata.deletionTimestamp == null)] | length == 0' \
      <<<"$pods" >/dev/null 2>&1; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

verify_helm_workload_image() {
  local expected_image="$1"
  local expected_digest="${expected_image##*@}"
  local deployment pods

  kubectl_logged rollout status "deployment/${helm_deployment_name}" --namespace "$helm_namespace" \
    --timeout=15m || return 1
  deployment=$(kubectl_capture get deployment "$helm_deployment_name" --namespace "$helm_namespace" -o json) ||
    return 1
  jq -e --arg image "$expected_image" \
    --arg container "$helm_deployment_name" \
    '[.spec.template.spec.containers[] | select(.name == $container and .image == $image)] | length == 1' \
    <<<"$deployment" >/dev/null 2>&1 || return 1
  pods=$(kubectl_capture get pods --namespace "$helm_namespace" -l "$helm_selector" -o json) || return 1
  HELM_EXPECTED_DIGEST="$expected_digest" HELM_APP_CONTAINER="$helm_deployment_name" jq -e '
    [.items[] | select(.metadata.deletionTimestamp == null)] as $pods |
    ($pods | length) > 0 and
    all($pods[];
      any(.status.containerStatuses[]?;
        .name == $ENV.HELM_APP_CONTAINER and .ready == true and
        (.imageID | endswith("@" + $ENV.HELM_EXPECTED_DIGEST))))
  ' <<<"$pods" >/dev/null 2>&1
}

run_helm_runtime_check() {
  local expected_authority="$1"
  local output
  output=$(kubectl_capture exec --namespace "$helm_namespace" "deployment/${helm_deployment_name}" -- \
    formbricks-authzed activation runtime-check) || return 1
  jq -e --arg authority "$expected_authority" \
    '.status == "ready" and .authority == $authority' <<<"$output" >/dev/null 2>&1
}

wait_for_helm_application_health() {
  local attempt=1

  while [[ "$attempt" -le 30 ]]; do
    if kubectl_logged exec --namespace "$helm_namespace" "deployment/${helm_deployment_name}" -- \
      node -e '
        const port = process.env.PORT || "3000";
        fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(5000) })
          .then((response) => process.exit(response.ok ? 0 : 1))
          .catch(() => process.exit(1));
      '; then
      return 0
    fi
    sleep "${FORMBRICKS_UPGRADE_POLL_INTERVAL_SECONDS:-2}"
    attempt=$((attempt + 1))
  done
  return 1
}

write_temporary_chart_values() {
  local phase="$1"
  local execution="$2"
  local receipt="$3"
  local quiesced="$4"
  local effective endpoint mode app_name auth_secret token_key database_secret database_key
  local system_key insecure node_selector tolerations affinity

  effective=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" --all -o json) || return 1
  mode=$(jq -er '.authzed.mode' <<<"$effective") || return 1
  app_name=$(jq -r '(.nameOverride // empty | select(length > 0)) // "formbricks"' <<<"$effective")
  app_name="${app_name:0:63}"
  app_name="${app_name%-}"
  endpoint=$(jq -r '.authzed.endpoint // empty' <<<"$effective")
  if [[ -z "$endpoint" && "$mode" == "selfHosted" ]]; then
    endpoint=$(jq -r --arg fallback "${app_name}-spicedb" '.authzed.cluster.name // empty | select(length > 0) // $fallback' \
      <<<"$effective")
    endpoint="${endpoint:0:63}"
    endpoint="${endpoint%-}:50051"
  fi
  [[ -n "$endpoint" ]] || return 1
  auth_secret=$(jq -r --arg fallback "${app_name}-authzed" \
    '.authzed.auth.existingSecret // empty | select(length > 0) // $fallback' <<<"$effective")
  token_key=$(jq -er '.authzed.auth.tokenKey' <<<"$effective") || return 1
  database_secret=$(jq -r --arg fallback "${app_name}-app-secrets" \
    '.authzed.activation.database.existingSecret // empty | select(length > 0) // $fallback' <<<"$effective")
  database_key=$(jq -er '.authzed.activation.database.urlKey' <<<"$effective") || return 1
  system_key=$(jq -er '.authzed.systemKey' <<<"$effective") || return 1
  insecure=$(jq -r 'if (.authzed.insecure | type) == "boolean" then .authzed.insecure else (.authzed.mode == "selfHosted") end' \
    <<<"$effective")
  node_selector=$(jq -c '.deployment.nodeSelector // {}' <<<"$effective")
  tolerations=$(jq -c '.deployment.tolerations // []' <<<"$effective")
  affinity=$(jq -c '.deployment.affinity // {}' <<<"$effective")

  jq -cn \
    --arg targetRelease "$helm_release" \
    --arg generation "$helm_generation" \
    --arg phase "$phase" \
    --argjson execution "$execution" \
    --arg bridgeRepository "${bridge_image%@*}" \
    --arg bridgeDigest "$bridge_digest" \
    --arg bridgeManifestDigest "$bridge_runtime_manifest_digest" \
    --arg targetRepository "${target_image%@*}" \
    --arg targetDigest "$target_digest" \
    --arg targetManifestDigest "$target_runtime_manifest_digest" \
    --arg receipt "$receipt" \
    --argjson quiesced "$quiesced" \
    --arg endpoint "$endpoint" \
    --arg authSecret "$auth_secret" \
    --arg tokenKey "$token_key" \
    --arg databaseSecret "$database_secret" \
    --arg databaseKey "$database_key" \
    --arg systemKey "$system_key" \
    --argjson insecure "$insecure" \
    --argjson nodeSelector "$node_selector" \
    --argjson tolerations "$tolerations" \
    --argjson affinity "$affinity" \
    '{
      targetRelease: $targetRelease,
      generation: $generation,
      phase: $phase,
      execution: $execution,
      protocolVersion: 1,
      images: {
        bridge: { repository: $bridgeRepository, digest: $bridgeDigest, manifestDigest: $bridgeManifestDigest },
        candidate: { repository: $targetRepository, digest: $targetDigest, manifestDigest: $targetManifestDigest },
        pullPolicy: "IfNotPresent",
        pullSecrets: []
      },
      schema: { expectedCurrentDigest: "" },
      activation: { receipt: $receipt, workloadQuiesced: $quiesced },
      database: { existingSecret: { name: $databaseSecret, key: $databaseKey } },
      authzed: {
        endpoint: $endpoint,
        existingSecret: { name: $authSecret, key: $tokenKey },
        systemKey: $systemKey,
        insecure: $insecure,
        consistency: "fully_consistent"
      },
      cli: { executable: "formbricks-authzed" },
      job: {
        ttlSecondsAfterFinished: 600,
        activeDeadlineSeconds: {
          status: 300, prepare: 21600, audit: 21600, activate: 2100,
          rollbackBegin: 900, rollbackComplete: 900
        },
        activateConflictRetrySeconds: 960,
        activateConflictRetryIntervalSeconds: 5,
        resources: {
          requests: { cpu: "100m", memory: "256Mi" },
          limits: { memory: "1Gi" }
        }
      },
      nodeSelector: $nodeSelector,
      tolerations: $tolerations,
      affinity: $affinity
