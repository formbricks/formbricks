temporary_phase_job_output() {
  local phase="$1"
  local execution="$2"
  local jobs count job_name succeeded failed

  jobs=$(kubectl_capture get jobs --namespace "$helm_namespace" \
    -l "formbricks.com/upgrade-generation=${helm_generation},formbricks.com/upgrade-phase=${phase},formbricks.com/upgrade-execution=${execution}" \
    -o json) || return 1
  count=$(jq -r '.items | length' <<<"$jobs")
  [[ "$count" == "1" ]] || return 1
  job_name=$(jq -er '.items[0].metadata.name' <<<"$jobs") || return 1
  succeeded=$(jq -r '.items[0].status.succeeded // 0' <<<"$jobs")
  failed=$(jq -r '.items[0].status.failed // 0' <<<"$jobs")
  if [[ "$succeeded" != "1" && "$failed" == "0" ]]; then
    kubectl_logged wait --for=condition=complete --timeout=45m "job/${job_name}" \
      --namespace "$helm_namespace" || return 1
    jobs=$(kubectl_capture get job "$job_name" --namespace "$helm_namespace" -o json) || return 1
    succeeded=$(jq -r '.status.succeeded // 0' <<<"$jobs")
  fi
  [[ "$succeeded" == "1" ]] || return 1
  kubectl_capture logs --namespace "$helm_namespace" "job/${job_name}"
}

recover_temporary_helm_release() {
  local releases release_status history recovery_revision

  releases=$(helm_capture list --namespace "$helm_namespace" --all -o json) || return 1
  release_status=$(jq -er --arg release "$helm_upgrade_release" '
    [.[] | select(.name == $release)] |
    if length == 0 then "absent"
    elif length == 1 then (.[0].status // "unknown")
    else error("ambiguous temporary release")
    end
  ' <<<"$releases") || return 1

  case "$release_status" in
    absent|deployed|failed) return 0 ;;
    pending-install)
      # The chart contains only disposable coordination objects. If the initial Helm client vanished
      # before storing a release revision, remove that incomplete shell and recreate the same signed,
      # journal-bound phase. Database authority is consulted separately before any image choice.
      helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait || return 1
      ;;
    pending-upgrade|pending-rollback)
      history=$(helm_capture history "$helm_upgrade_release" --namespace "$helm_namespace" -o json) || return 1
      recovery_revision=$(jq -er '
        [.[] | select((.status == "deployed" or .status == "superseded") and (.revision | tonumber > 0))] |
        sort_by(.revision | tonumber) | last | .revision
      ' <<<"$history") || return 1
      # This rollback is deliberately restricted to the temporary, resource-only coordinator chart.
      # The application release is recovered separately according to database authority.
      helm_logged rollback "$helm_upgrade_release" "$recovery_revision" --namespace "$helm_namespace" \
        --no-hooks --wait --timeout 15m || return 1
      ;;
    *) return 1 ;;
  esac
}

run_temporary_phase() {
  local phase="$1"
  local receipt="${2:-}"
  local quiesced="${3:-false}"
  local pending_phase pending_execution execution output

  if [[ -z "$receipt" ]]; then
    receipt=$(jq -r '.receipt // empty' "$helm_state_path")
  fi

  pending_phase=$(jq -r '.pendingPhase // empty' "$helm_state_path")
  pending_execution=$(jq -r '.pendingExecution // 0' "$helm_state_path")
  if [[ "$pending_phase" == "$phase" && "$pending_execution" -gt 0 ]]; then
    execution="$pending_execution"
    output=$(temporary_phase_job_output "$phase" "$execution" 2>/dev/null || true)
    if [[ -n "$output" ]]; then
      printf '%s' "$output"
      return 0
    fi
    execution=$(jq -r '.execution + 1' "$helm_state_path")
    write_helm_journal "$(jq -r '.state' "$helm_state_path")" "$receipt" "$phase" "$execution"
  else
    execution=$(jq -r '.execution + 1' "$helm_state_path")
    write_helm_journal "$(jq -r '.state' "$helm_state_path")" "$receipt" "$phase" "$execution"
  fi

  recover_temporary_helm_release || return 1
  write_temporary_chart_values "$phase" "$execution" "$receipt" "$quiesced" || return 1
  printf '%s\n' "🔐 Running the signed Helm ${phase} coordinator phase." >&2
  helm_logged upgrade --install "$helm_upgrade_release" "$upgrade_chart_path" \
    --namespace "$helm_namespace" --reset-values --values "$helm_phase_values_file" \
    --wait --wait-for-jobs --timeout 45m || return 1
  output=$(temporary_phase_job_output "$phase" "$execution") || return 1
  printf '%s' "$output"
}

get_activation_status_via_chart() {
  local output
  output=$(run_temporary_phase status "" false) || return 1
  jq -cer 'select(.status == "ready" and (.authority | IN("legacy", "spicedb"))) |
    {authority, transition}' <<<"$output"
}

current_main_helm_release_status() {
  local releases
  releases=$(helm_capture list --namespace "$helm_namespace" --all -o json) || return 1
  jq -er --arg release "$helm_release" '
    [.[] | select(.name == $release)] |
    select(length == 1) | .[0].status
  ' <<<"$releases"
}

validate_original_helm_revision() {
  local revision="$1"
  local revision_values expected_values
  revision_values=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" \
    --revision "$revision" -o json) || return 1
  expected_values=$(jq -Sc '.originalValues' "$helm_state_path") || return 1
  revision_values=$(jq -Sc '.' <<<"$revision_values") || return 1
  [[ "$revision_values" == "$expected_values" ]]
}

find_quiesced_bridge_revision() {
  local history revisions revision revision_values repository digest
  repository="${bridge_image%@*}"
  digest="${bridge_image##*@}"
  history=$(helm_capture history "$helm_release" --namespace "$helm_namespace" -o json) || return 1
  revisions=$(jq -r '
    [.[] | select(.status == "deployed" or .status == "superseded")] |
    sort_by(.revision | tonumber) | reverse | .[].revision
  ' <<<"$history") || return 1
  while IFS= read -r revision; do
    [[ -n "$revision" ]] || continue
    revision_values=$(helm_capture get values "$helm_release" --namespace "$helm_namespace" \
      --revision "$revision" -o json) || continue
    if jq -e --arg repository "$repository" --arg digest "$digest" '
      .deployment.image.repository == $repository and
      .deployment.image.digest == $digest and
      .deployment.replicas == 0 and
      .autoscaling.enabled == false and
      .migration.mode == "external" and
      .authzed.activation.installBootstrap.enabled == false and
      .authzed.activation.upgradeGate.enabled == false
    ' <<<"$revision_values" >/dev/null 2>&1; then
      printf '%s' "$revision"
      return 0
    fi
  done <<<"$revisions"
  return 1
}

recover_pending_main_helm_release() {
  local authority="$1"
  local release_status recovery_revision original_revision

  release_status=$(current_main_helm_release_status) || return 1
  case "$release_status" in
    deployed|failed) return 0 ;;
    pending-upgrade|pending-rollback) ;;
    *) return 1 ;;
  esac

  if [[ "$authority" == "legacy" ]]; then
    original_revision=$(jq -er '.release.revision' "$helm_state_path") || return 1
    validate_original_helm_revision "$original_revision" || return 1
    recovery_revision="$original_revision"
  elif [[ "$authority" == "spicedb" ]]; then
    # Never restore a live legacy revision after authority has changed. The only safe Helm unlock
    # target is a previously rendered exact bridge revision with zero replicas and no HPA.
    recovery_revision=$(find_quiesced_bridge_revision) || return 1
  else
    return 1
  fi

  printf '%s\n' "↩️ Recovering an interrupted Helm client at a journal-verified safe revision." >&2
  helm_logged rollback "$helm_release" "$recovery_revision" --namespace "$helm_namespace" \
    --no-hooks --wait --timeout 30m || return 1
  if [[ "$authority" == "spicedb" ]]; then
    wait_for_zero_formbricks_pods || return 1
  fi
}

verify_original_helm_workload() {
  local expected_image replicas hpa_enabled deployment

  expected_image=$(jq -er '.workload.originalImage' "$helm_state_path") || return 1
  replicas=$(jq -er '.workload.replicas' "$helm_state_path") || return 1
  hpa_enabled=$(jq -er '.workload.hpa.enabled' "$helm_state_path") || return 1
  kubectl_logged rollout status "deployment/${helm_deployment_name}" --namespace "$helm_namespace" \
    --timeout=15m || return 1
  deployment=$(kubectl_capture get deployment "$helm_deployment_name" --namespace "$helm_namespace" -o json) ||
    return 1
  jq -e --arg image "$expected_image" --arg container "$helm_deployment_name" '
    [.spec.template.spec.containers[] | select(.name == $container and .image == $image)] | length == 1
  ' <<<"$deployment" >/dev/null 2>&1 || return 1

  # A deliberately dormant release has no application process to probe. Its exact Deployment image
  # and zero-Pod state are the complete safe-source assertion; active releases must answer /health.
  if [[ "$replicas" == "0" && "$hpa_enabled" == "false" ]]; then
    wait_for_zero_formbricks_pods
  else
    wait_for_helm_application_health
  fi
}

restore_original_helm_release() {
  local original_revision release_status

  original_revision=$(jq -er '.release.revision' "$helm_state_path") || return 1
  validate_original_helm_revision "$original_revision" || return 1
  release_status=$(current_main_helm_release_status) || return 1
  case "$release_status" in
    pending-upgrade|pending-rollback)
      recover_pending_main_helm_release legacy || return 1
      verify_original_helm_workload
      return $?
      ;;
    deployed)
      if verify_original_helm_workload; then
        return 0
      fi
      ;;
    failed) ;;
    *) return 1 ;;
  esac

  printf '%s\n' "↩️ Restoring the journal-verified pre-upgrade Helm revision." >&2
  helm_logged rollback "$helm_release" "$original_revision" --namespace "$helm_namespace" \
    --no-hooks --wait --timeout 30m || return 1
  verify_original_helm_workload
}

restore_helm_bridge() {
  local intended="$1"
  local replicas hpa_enabled

  # A vanished Helm client can leave the application release locked. Database authority is legacy
  # at every call site here, so only the journal-verified original revision may unlock it.
  recover_pending_main_helm_release legacy || return 1

  if [[ "$intended" == "true" ]]; then
    replicas=$(jq -r '.workload.replicas' "$helm_state_path")
    hpa_enabled=$(jq -r '.workload.hpa.enabled' "$helm_state_path")
  else
    replicas=1
    hpa_enabled=false
  fi
  write_main_phase_values "$bridge_image" external "$replicas" "$hpa_enabled" false
  run_main_chart_upgrade "bridge recovery" &&
    verify_helm_workload_image "$bridge_image" &&
    run_helm_runtime_check legacy
}

quiesce_helm_candidate_for_rollback() {
  local release_status
  release_status=$(current_main_helm_release_status) || return 1
  if [[ "$release_status" == "pending-upgrade" || "$release_status" == "pending-rollback" ]]; then
    recover_pending_main_helm_release spicedb || return 1
    wait_for_zero_formbricks_pods
    return $?
  fi
  [[ "$release_status" == "deployed" || "$release_status" == "failed" ]] || return 1

  write_main_phase_values "$target_image" external 0 false true
  run_main_chart_upgrade "quiesced rollback candidate" && wait_for_zero_formbricks_pods
}

rollback_helm_after_activation() {
  local receipt="$1"
  local rollback_output status_output authority

  printf '%s\n' "↩️ Candidate verification failed; restoring the signed Helm bridge." >&2
  status_output=$(get_activation_status_via_chart 2>/dev/null || true)
  authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
  if [[ "$authority" == "legacy" ]]; then
    # A previous rollback-complete transaction may have committed before its client received the
    # response. Repeating the exact receipt is the only accepted legacy/idle completion path.
    rollback_output=$(run_temporary_phase rollback-complete "$receipt" false) || return 1
    jq -e '.status == "rolled_back"' <<<"$rollback_output" >/dev/null 2>&1 || return 1
    restore_helm_bridge true || return 1
    write_helm_journal rolled_back "$receipt"
    helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait || return 1
    return 0
  fi
  [[ "$authority" == "spicedb" ]] || return 1

  quiesce_helm_candidate_for_rollback || return 1
  rollback_output=$(run_temporary_phase rollback-begin "$receipt" true) || return 1
  jq -e '.status == "rollback_started"' <<<"$rollback_output" >/dev/null 2>&1 || return 1
  write_helm_journal rollback_started "$receipt"

  write_main_phase_values "$bridge_image" external 1 false false
  run_main_chart_upgrade "rollback bridge" || return 1
  verify_helm_workload_image "$bridge_image" || return 1
  run_helm_runtime_check legacy || return 1
  write_helm_journal rollback_bridge_ready "$receipt"

  rollback_output=$(run_temporary_phase rollback-complete "$receipt" false) || return 1
  jq -e '.status == "rolled_back"' <<<"$rollback_output" >/dev/null 2>&1 || return 1
  restore_helm_bridge true || return 1
  write_helm_journal rolled_back "$receipt"
  helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait || return 1
}

emit_helm_upgrade_success() {
  jq -cn --arg releaseVersion "$release_version" \
    '{schemaVersion: 1, status: "upgraded", mutating: true, installType: "helm", releaseVersion: $releaseVersion}'
}

execute_helm_upgrade() {
  local journal state receipt status_output authority transition prepare_output audit_output activate_output
  local replicas hpa_enabled finalize_output
  local resume_activation=false

  if [[ "$resolved_install_type" != "helm" ]]; then
    emit_bootstrap_error "helm_upgrade_required"
    return 2
  fi
  if [[ "$confirmed" != "true" || "$backup_confirmed" != "true" ]]; then
    emit_bootstrap_error "helm_confirmation_required"
    return 2
  fi
  if ! verify_helm_release_assets; then
    emit_bootstrap_error "signed_helm_artifact_invalid"
    return 2
  fi

  if [[ -z "$helm_state_path" ]]; then
    helm_state_path="${PWD}/.formbricks-v6-helm-upgrade-${helm_namespace}-${helm_release}.json"
  fi
  helm_upgrade_log="${helm_state_path%.json}.log"
  umask 077
  touch "$helm_upgrade_log"
  chmod 600 "$helm_upgrade_log"

  if [[ "$action" == "resume" ]]; then
    journal=$(read_bound_helm_journal || true)
    if [[ -z "$journal" ]]; then
      emit_bootstrap_error "helm_upgrade_state_invalid"
      return 2
    fi
  else
    if [[ -e "$helm_state_path" ]]; then
      emit_bootstrap_error "helm_upgrade_state_exists"
      return 2
    fi
    set +e
    initialize_helm_journal
    initialize_result=$?
    set -e
    if [[ "$initialize_result" -ne 0 ]]; then
      case "$initialize_result" in
        3) emit_bootstrap_error "gitops_reconciliation_not_paused" ;;
        *) emit_bootstrap_error "helm_workload_snapshot_failed" ;;
      esac
      return 2
    fi
    journal=$(read_bound_helm_journal || true)
    if [[ -z "$journal" ]]; then
      emit_bootstrap_error "helm_upgrade_state_invalid"
      return 2
    fi
  fi

  load_helm_journal_files "$journal"
  trap cleanup_helm_work_directory EXIT
  state=$(jq -r '.state' "$helm_state_path")
  receipt=$(jq -r '.receipt // empty' "$helm_state_path")

  if [[ "$state" == "completed" ]]; then
    write_main_phase_values "$target_image" "" \
      "$(jq -r '.workload.replicas' "$helm_state_path")" \
      "$(jq -r '.workload.hpa.enabled' "$helm_state_path")" true
    if verify_helm_workload_image "$target_image" && run_helm_runtime_check spicedb &&
      wait_for_helm_application_health; then
      emit_helm_upgrade_success
      return 0
    fi
    emit_bootstrap_error "helm_completed_state_invalid"
    return 1
  fi

  if [[ "$action" == "resume" && "$state" != "completed" ]]; then
    # An initialized journal cannot have crossed the authority boundary: no receipt has been prepared.
    # This lets recovery unlock a Helm client that disappeared during the first bridge upgrade, even
    # when SpiceDB resources were not created far enough for the status Job to start.
    authority=legacy
    transition=idle
    if [[ "$state" != "initialized" ]]; then
      # The process may have disappeared after a database transaction committed but before the journal
      # write. Consult the durable authority state before choosing an image; never infer authority from
      # the running image or the journal alone.
      status_output=$(get_activation_status_via_chart 2>/dev/null || true)
      authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
      transition=$(jq -r '.transition // empty' <<<"$status_output" 2>/dev/null || true)
      if [[ "$authority" == "spicedb" ]]; then
        if [[ -z "$receipt" ]]; then
          write_helm_journal manual_recovery_required
          emit_bootstrap_error "helm_activation_state_requires_recovery"
          return 1
        fi
        if [[ "$transition" == "rollback_fencing" || "$transition" == "rolling_back" ]]; then
          write_helm_journal rollback_started "$receipt"
          state=rollback_started
        else
          write_helm_journal activated "$receipt"
          state=activated
        fi
      elif [[ "$authority" != "legacy" ]]; then
        write_helm_journal manual_recovery_required "$receipt"
        emit_bootstrap_error "helm_activation_status_failed"
        return 1
      elif [[ "$transition" == "activating" && "$state" == "quiesced" && -n "$receipt" ]]; then
        resume_activation=true
      fi
    fi

    if ! recover_pending_main_helm_release "$authority"; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_release_recovery_failed"
      return 1
    fi
  fi

  if [[ "$state" == "rollback_started" || "$state" == "rollback_bridge_ready" ||
    "$state" == "manual_recovery_required" ]]; then
    if [[ -n "$receipt" ]] && rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "interrupted_helm_upgrade_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_rollback_incomplete"
    fi
    return 1
  fi

  if [[ "$state" == "activated" || "$state" == "candidate_ready" || "$state" == "finalized" ]]; then
    authority=spicedb
    transition=activating
  else
    authority=legacy
    transition=idle
  fi

  if [[ "$resume_activation" == "true" ]]; then
    if ! wait_for_zero_formbricks_pods; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_interrupted_activation_not_quiesced"
      return 1
    fi
    activate_output=$(run_temporary_phase activate "$receipt" true) || {
      status_output=$(get_activation_status_via_chart 2>/dev/null || true)
      authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
      if [[ "$authority" == "spicedb" ]]; then
        write_helm_journal activated "$receipt"
        rollback_helm_after_activation "$receipt" || write_helm_journal manual_recovery_required "$receipt"
      else
        restore_helm_bridge true || true
      fi
      emit_bootstrap_error "helm_activation_failed"
      return 1
    }
    if ! jq -e '.status == "activated"' <<<"$activate_output" >/dev/null 2>&1; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_activation_failed"
      return 1
    fi
    write_helm_journal activated "$receipt"
    state=activated
  fi

  if [[ "$state" != "activated" && "$state" != "candidate_ready" && "$state" != "finalized" ]]; then
    write_main_phase_values "$bridge_image" job \
      "$(jq -r '.workload.replicas' "$helm_state_path")" \
      "$(jq -r '.workload.hpa.enabled' "$helm_state_path")" false
    if ! run_main_chart_upgrade "legacy-authoritative bridge" ||
      ! verify_helm_workload_image "$bridge_image" || ! run_helm_runtime_check legacy; then
      if restore_original_helm_release; then
        emit_bootstrap_error "helm_bridge_deployment_failed"
      else
        write_helm_journal manual_recovery_required "$receipt"
        emit_bootstrap_error "helm_bridge_deployment_recovery_incomplete"
      fi
      return 1
    fi
    write_helm_journal bridge_ready "$receipt"

    status_output=$(get_activation_status_via_chart) || {
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_activation_status_failed"
      return 1
    }
    authority=$(jq -r '.authority' <<<"$status_output")
    transition=$(jq -r '.transition' <<<"$status_output")
    if [[ "$authority" == "spicedb" ]]; then
      if [[ -z "$receipt" ]]; then
        write_helm_journal manual_recovery_required
        emit_bootstrap_error "helm_activation_state_requires_recovery"
        return 1
      fi
      write_helm_journal activated "$receipt"
    elif [[ "$authority" != "legacy" ||
      ("$transition" != "idle" && "$transition" != "prepared" && "$transition" != "preparing") ]]; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_activation_state_requires_recovery"
      return 1
    fi
  fi

  state=$(jq -r '.state' "$helm_state_path")
  if [[ "$state" != "activated" && "$state" != "candidate_ready" && "$state" != "finalized" ]]; then
    prepare_output=$(run_temporary_phase prepare "" false) || {
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_activation_prepare_failed"
      return 1
    }
    receipt=$(jq -er 'select(.status == "prepared") | .receipt' <<<"$prepare_output" 2>/dev/null || true)
    if [[ -z "$receipt" ]]; then
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_activation_prepare_failed"
      return 1
    fi
    write_helm_journal prepared "$receipt"

    audit_output=$(run_temporary_phase audit "$receipt" false) || {
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_relationship_audit_failed"
      return 1
    }
    if ! jq -e '.status == "reconciled" and .truncated == false and (.failures | length) == 0' \
      <<<"$audit_output" >/dev/null 2>&1; then
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_relationship_audit_dirty"
      return 1
    fi
    write_helm_journal audited "$receipt"

    write_main_phase_values "$bridge_image" external 0 false false
    if ! run_main_chart_upgrade "quiesced bridge" || ! wait_for_zero_formbricks_pods; then
      restore_helm_bridge true || true
      emit_bootstrap_error "helm_workload_quiesce_failed"
      return 1
    fi
    write_helm_journal quiesced "$receipt"

    activate_output=$(run_temporary_phase activate "$receipt" true) || {
      status_output=$(get_activation_status_via_chart 2>/dev/null || true)
      authority=$(jq -r '.authority // empty' <<<"$status_output" 2>/dev/null || true)
      if [[ "$authority" == "spicedb" ]]; then
        write_helm_journal activated "$receipt"
        rollback_helm_after_activation "$receipt" || write_helm_journal manual_recovery_required "$receipt"
      else
        restore_helm_bridge true || true
      fi
      emit_bootstrap_error "helm_activation_failed"
      return 1
    }
    if ! jq -e '.status == "activated"' <<<"$activate_output" >/dev/null 2>&1; then
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_activation_failed"
      return 1
    fi
    write_helm_journal activated "$receipt"
  fi

  write_main_phase_values "$target_image" external 1 false true
  if ! run_main_chart_upgrade "authoritative candidate" || ! verify_helm_workload_image "$target_image" ||
    ! run_helm_runtime_check spicedb || ! wait_for_helm_application_health; then
    if rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "helm_candidate_failed_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_candidate_failed_rollback_incomplete"
    fi
    return 1
  fi
  write_helm_journal candidate_ready "$receipt"

  finalize_output=$(kubectl_capture exec --namespace "$helm_namespace" "deployment/${helm_deployment_name}" -- \
    formbricks-authzed activation finalize --receipt "$receipt" || true)
  if ! jq -e '.status == "finalized"' <<<"$finalize_output" >/dev/null 2>&1; then
    if rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "helm_finalize_failed_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_finalize_failed_rollback_incomplete"
    fi
    return 1
  fi
  write_helm_journal finalized "$receipt"

  replicas=$(jq -r '.workload.replicas' "$helm_state_path")
  hpa_enabled=$(jq -r '.workload.hpa.enabled' "$helm_state_path")
  # The candidate is held in external migration mode only while the authority transaction is open.
  # Omit the phase override after finalization so the operator's intended value (or the v6 default
  # migration Job) governs every later ordinary Helm upgrade.
  write_main_phase_values "$target_image" "" "$replicas" "$hpa_enabled" true
  if ! run_main_chart_upgrade "restored candidate" || ! verify_helm_workload_image "$target_image" ||
    ! run_helm_runtime_check spicedb; then
    if rollback_helm_after_activation "$receipt"; then
      emit_bootstrap_error "helm_restore_failed_rolled_back"
    else
      write_helm_journal manual_recovery_required "$receipt"
      emit_bootstrap_error "helm_restore_failed_rollback_incomplete"
    fi
    return 1
  fi

  if ! helm_logged uninstall "$helm_upgrade_release" --namespace "$helm_namespace" --wait; then
    emit_bootstrap_error "helm_temporary_cleanup_failed"
    return 1
  fi
  write_helm_journal completed "$receipt"
  emit_helm_upgrade_success
}

plan='[]'
status="blocked"
if [[ "$blocked_count" -eq 0 && "$action" == "resume" ]]; then
  # A bridge or interrupted candidate already reports v6. The signed-pair-bound journal and database
  # activation state, not the running image's major version, decide whether recovery is complete.
  status="ready"
  plan=$(jq -cn '[
    {order: 1, phase: "resume_from_journal", mutating: true, requiresConfirmation: true},
    {order: 2, phase: "verify_database_authority", mutating: false, requiresConfirmation: false},
    {order: 3, phase: "complete_or_rollback", mutating: true, requiresConfirmation: true}
  ]')
elif [[ "$blocked_count" -eq 0 && "$version_state" == "already_target_major" ]]; then
  status="not_required"
elif [[ "$blocked_count" -eq 0 ]]; then
  status="ready"
  plan=$(jq -cn '[
    {order: 1, phase: "backup", mutating: false, requiresConfirmation: true},
    {order: 2, phase: "prepare_runtime", mutating: true, requiresConfirmation: true},
    {order: 3, phase: "build_relationship_graph", mutating: true, requiresConfirmation: true},
    {order: 4, phase: "fence_and_activate", mutating: true, requiresConfirmation: true},
    {order: 5, phase: "verify", mutating: false, requiresConfirmation: false},
    {order: 6, phase: "remove_temporary_resources", mutating: true, requiresConfirmation: true}
  ]')
fi

preflight_result=$(jq -cn \
  --argjson schemaVersion "$ASSISTANT_SCHEMA_VERSION" \
  --arg status "$status" \
  --arg installType "$resolved_install_type" \
  --arg currentVersion "$current_version" \
  --arg databaseMode "$database_mode" \
  --argjson currentImagePinned "$current_image_pinned" \
  --arg currentImageDigest "$current_image_digest" \
  --argjson authzedConfigured "$authzed_configured" \
  --arg releaseVersion "$release_version" \
  --arg manifestDigest "$manifest_digest" \
  --arg bridgeDigest "$bridge_digest" \
  --arg bridgeRuntimeManifestDigest "$bridge_runtime_manifest_digest" \
  --arg formbricksChart "$formbricks_chart" \
  --arg targetDigest "$target_digest" \
  --arg targetRuntimeManifestDigest "$target_runtime_manifest_digest" \
  --arg upgradeChart "$upgrade_chart" \
  --argjson warningCount "$warning_count" \
  --argjson checks "$checks" \
  --argjson plan "$plan" \
  '{
    schemaVersion: $schemaVersion,
    status: $status,
    mutating: false,
    installation: {
      type: $installType,
      currentVersion: (if $currentVersion == "" then null else $currentVersion end),
      currentImagePinned: $currentImagePinned,
      currentImageDigest: (if $currentImageDigest == "" then null else $currentImageDigest end),
      databaseMode: $databaseMode,
      authzedConfigured: $authzedConfigured
    },
    release: {
      version: (if $releaseVersion == "" then null else $releaseVersion end),
      manifestDigest: (if $manifestDigest == "" then null else ("sha256:" + $manifestDigest) end),
      bridgeImageDigest: (if $bridgeDigest == "" then null else $bridgeDigest end),
      bridgeRuntimeManifestDigest: (if $bridgeRuntimeManifestDigest == "" then null else $bridgeRuntimeManifestDigest end),
      formbricksChart: (if $formbricksChart == "" then null else $formbricksChart end),
      targetImageDigest: (if $targetDigest == "" then null else $targetDigest end),
      targetRuntimeManifestDigest: (if $targetRuntimeManifestDigest == "" then null else $targetRuntimeManifestDigest end),
      upgradeChart: (if $upgradeChart == "" then null else $upgradeChart end)
    },
    warningCount: $warningCount,
    checks: $checks,
    plan: $plan
  }')

if [[ "$status" == "blocked" ]]; then
  printf '%s\n' "$preflight_result"
  exit 2
fi

if [[ "$action" == "preflight" ]]; then
  printf '%s\n' "$preflight_result"
  exit 0
fi

if [[ "$status" != "ready" && ! ( "$status" == "not_required" && "$install_type" == "docker" ) ]]; then
  printf '%s\n' "$preflight_result"
  exit 0
fi

if [[ "$resolved_install_type" == "helm" ]]; then
  execute_helm_upgrade
  exit $?
fi

execute_docker_upgrade
